<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CYBER BYPASS ENGINE V4.0 - by Ramzyy03</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600&family=Orbitron:wght@500;700;900&family=Rajdhani:wght@500;600;700&display=swap');

    :root {
      --bg-main: #020205;
      --card-bg: rgba(12, 12, 20, 0.8);
      --neon-cyan: #00f3ff;
      --neon-purple: #b026ff;
      --neon-green: #00ff88;
      --neon-red: #ff2a2a;
      --text-main: #f1f5f9;
      --text-muted: #64748b;
      --border-glow: rgba(176, 38, 255, 0.25);
      --font-ui: 'Rajdhani', sans-serif;
      --font-mono: 'Fira Code', monospace;
      --font-display: 'Orbitron', sans-serif;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background-color: var(--bg-main);
      color: var(--text-main);
      font-family: var(--font-ui);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow-x: hidden;
      background-image: 
        radial-gradient(circle at 15% 15%, rgba(176, 38, 255, 0.08) 0%, transparent 40%),
        radial-gradient(circle at 85% 85%, rgba(0, 243, 255, 0.08) 0%, transparent 40%);
    }

    /* Cyber Scanline */
    body::after {
      content: " "; display: block; position: fixed; top: 0; left: 0; bottom: 0; right: 0;
      background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.3) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.03), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.03));
      z-index: 2; background-size: 100% 3px, 3px 100%; pointer-events: none;
    }

    /* --- CYBER MATRIX VERIFICATION OVERLAY --- */
    .cf-overlay {
      position: fixed; top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(2, 2, 5, 0.96); backdrop-filter: blur(14px);
      z-index: 9999; display: flex; flex-direction: column; justify-content: center; align-items: center;
      transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cf-overlay.hidden { opacity: 0; pointer-events: none; }
    
    .cf-box {
      background: linear-gradient(135deg, rgba(20, 20, 30, 0.95), rgba(10, 10, 15, 0.98));
      border: 1px solid var(--neon-purple);
      border-radius: 16px; padding: 30px; width: 100%; max-width: 380px;
      box-shadow: 0 0 40px rgba(176, 38, 255, 0.25), inset 0 0 15px rgba(176, 38, 255, 0.08);
      display: flex; flex-direction: column; gap: 20px; text-align: center;
      position: relative; overflow: hidden;
    }
    .cf-box::before {
      content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 2px;
      background: linear-gradient(90deg, transparent, var(--neon-cyan), var(--neon-purple), transparent);
      animation: scan-line 2s linear infinite;
    }
    @keyframes scan-line { 0% { transform: translateX(-100%); } 100% { transform: translateX(100%); } }

    .cf-title { font-family: var(--font-display); font-size: 0.95rem; color: var(--neon-cyan); letter-spacing: 1px; }
    .cf-desc { font-size: 0.78rem; color: var(--text-muted); font-family: var(--font-mono); }
    
    .matrix-btn {
      background: rgba(0, 243, 255, 0.05); border: 1px solid var(--neon-cyan);
      border-radius: 10px; padding: 15px; display: flex; align-items: center; gap: 15px;
      cursor: pointer; transition: all 0.3s;
    }
    .matrix-btn:hover { background: rgba(0, 243, 255, 0.15); box-shadow: 0 0 15px rgba(0, 243, 255, 0.3); }
    
    .matrix-checkbox {
      width: 26px; height: 26px; border: 2px solid var(--neon-cyan); border-radius: 6px;
      display: flex; justify-content: center; align-items: center; position: relative; flex-shrink: 0;
    }
    .matrix-checkbox.loading { border-color: transparent; border-top-color: var(--neon-purple); animation: spin 0.8s linear infinite; }
    .matrix-checkbox.success { border-color: var(--neon-green); background: rgba(0, 255, 136, 0.2); box-shadow: 0 0 10px var(--neon-green); }
    @keyframes spin { 100% { transform: rotate(360deg); } }
    
    .matrix-label { font-family: var(--font-ui); font-size: 0.95rem; font-weight: 600; color: #fff; text-align: left; line-height: 1.2; }
    .cf-footer-secure { font-size: 0.7rem; color: var(--text-muted); font-family: var(--font-mono); border-top: 1px solid rgba(255,255,255,0.05); padding-top: 12px; }

    /* --- MAIN APP WRAPPER --- */
    .app-wrapper {
      width: 100%; max-width: 520px; padding: 20px; z-index: 10;
      display: none; flex-direction: column; gap: 16px;
      animation: zoom-in 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .app-wrapper.active { display: flex; }
    @keyframes zoom-in { 0% { opacity: 0; transform: scale(0.92); filter: blur(8px); } 100% { opacity: 1; transform: scale(1); filter: blur(0); } }

    /* HUD Header */
    .hud-header {
      background: var(--card-bg); backdrop-filter: blur(16px);
      border: 1px solid var(--border-glow); border-radius: 14px; padding: 16px 20px;
      display: flex; justify-content: space-between; align-items: center;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }
    .hud-title h1 { font-family: var(--font-display); font-size: 1.3rem; color: #fff; letter-spacing: 1px; text-shadow: 0 0 10px rgba(176, 38, 255, 0.5); }
    .hud-title p { font-size: 0.72rem; color: var(--neon-cyan); font-family: var(--font-mono); }
    
    .hud-stats { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; }
    .status-badge { display: flex; align-items: center; gap: 6px; font-size: 0.68rem; font-family: var(--font-mono); color: var(--neon-green); background: rgba(0, 255, 136, 0.1); padding: 3px 8px; border-radius: 20px; border: 1px solid rgba(0, 255, 136, 0.3); }
    .status-dot { width: 6px; height: 6px; background: var(--neon-green); border-radius: 50%; box-shadow: 0 0 8px var(--neon-green); animation: pulse 1.5s infinite; }
    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
    .ping-text { font-size: 0.62rem; color: var(--text-muted); font-family: var(--font-mono); }

    /* Panels */
    .panel {
      background: var(--card-bg); backdrop-filter: blur(16px);
      border: 1px solid var(--border-glow); border-radius: 14px; padding: 18px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5); position: relative;
    }
    .panel-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
    .panel-title { font-family: var(--font-display); font-size: 0.82rem; color: var(--neon-cyan); display: flex; align-items: center; gap: 8px; }
    .panel-title::before { content: ''; width: 6px; height: 6px; background: var(--neon-cyan); border-radius: 50%; box-shadow: 0 0 8px var(--neon-cyan); }

    /* Mode & Options Bar */
    .options-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; gap: 8px; }
    .mode-tabs { display: flex; background: rgba(0,0,0,0.4); border-radius: 8px; padding: 3px; border: 1px solid rgba(255,255,255,0.05); flex: 1; }
    .tab-btn { flex: 1; background: transparent; border: none; color: var(--text-muted); font-family: var(--font-ui); font-weight: 600; font-size: 0.75rem; padding: 5px; border-radius: 6px; cursor: pointer; transition: all 0.3s; }
    .tab-btn.active { background: var(--neon-purple); color: #fff; box-shadow: 0 0 10px rgba(176, 38, 255, 0.4); }

    .engine-mode-select {
      background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.1); color: var(--neon-cyan);
      font-family: var(--font-mono); font-size: 0.72rem; padding: 6px 10px; border-radius: 8px; outline: none; cursor: pointer;
    }

    /* Input & Action Buttons */
    .input-wrapper { position: relative; margin-bottom: 12px; }
    .input-box {
      width: 100%; padding: 14px 45px 14px 14px; background: rgba(0,0,0,0.6); border: 1px solid rgba(255,255,255,0.1);
      border-radius: 10px; color: #fff; font-family: var(--font-mono); font-size: 0.82rem; outline: none; transition: all 0.3s; resize: none;
    }
    .input-box:focus { border-color: var(--neon-purple); box-shadow: 0 0 15px rgba(176, 38, 255, 0.25); }

    .paste-btn {
      position: absolute; right: 10px; top: 50%; transform: translateY(-50%);
      background: rgba(176, 38, 255, 0.15); border: 1px solid rgba(176, 38, 255, 0.4); color: var(--neon-purple);
      padding: 6px 10px; border-radius: 6px; font-size: 0.68rem; font-family: var(--font-mono); cursor: pointer; transition: 0.2s;
    }
    .paste-btn:hover { background: rgba(176, 38, 255, 0.3); color: #fff; }

    .btn-group { display: flex; gap: 8px; }
    .btn {
      flex: 1; padding: 13px; border: none; border-radius: 10px; font-family: var(--font-display);
      font-weight: 700; font-size: 0.82rem; letter-spacing: 1px; cursor: pointer; display: flex;
      justify-content: center; align-items: center; gap: 8px; transition: all 0.25s;
    }
    .btn-main { background: linear-gradient(135deg, var(--neon-purple), #6366f1); color: #fff; box-shadow: 0 0 20px rgba(176, 38, 255, 0.4); }
    .btn-main:hover { transform: translateY(-2px); box-shadow: 0 0 25px rgba(176, 38, 255, 0.7); }
    .btn-main:active { transform: scale(0.97); }
    .btn-main:disabled { background: #222; color: #555; box-shadow: none; cursor: not-allowed; transform: none; }

    .btn-sec { background: transparent; border: 1px solid var(--neon-cyan); color: var(--neon-cyan); }
    .btn-sec:hover { background: rgba(0, 243, 255, 0.1); }
    .btn-sec:disabled { border-color: #222; color: #555; cursor: not-allowed; }

    /* QR Code Modal / Container Preview */
    .qr-preview-box {
      margin-top: 10px; background: rgba(0,0,0,0.4); border: 1px dashed rgba(0, 243, 255, 0.3);
      border-radius: 8px; padding: 10px; display: none; align-items: center; gap: 12px;
      animation: fadeIn 0.3s ease;
    }
    .qr-preview-box.active { display: flex; }
    .qr-image { width: 55px; height: 55px; background: #fff; padding: 3px; border-radius: 4px; }
    .qr-info { font-size: 0.72rem; font-family: var(--font-mono); color: var(--text-muted); word-break: break-all; }
    .qr-info span { color: var(--neon-cyan); display: block; font-weight: bold; }

    /* Terminal Console */
    .terminal { background: #010103; border-color: rgba(0, 243, 255, 0.15); }
    .term-window { height: 110px; overflow-y: auto; font-family: var(--font-mono); font-size: 0.72rem; line-height: 1.5; color: var(--text-muted); display: flex; flex-direction: column; gap: 4px; }
    .log-sys { color: #888; } .log-warn { color: #f59e0b; } .log-succ { color: var(--neon-green); text-shadow: 0 0 6px rgba(0,255,136,0.4); } .log-err { color: var(--neon-red); text-shadow: 0 0 6px rgba(255,42,42,0.4); } .log-info { color: var(--neon-cyan); }
    .blinking-cursor { display: inline-block; width: 5px; height: 11px; background: var(--neon-cyan); animation: blink 1s step-end infinite; margin-left: 4px; }
    @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

    /* History List & Actions */
    .history-actions { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; }
    .clear-history-btn { font-size: 0.65rem; background: transparent; border: none; color: var(--neon-red); cursor: pointer; font-family: var(--font-mono); }
    .clear-history-btn:hover { text-decoration: underline; }
    
    .history-list { display: flex; flex-direction: column; gap: 6px; max-height: 110px; overflow-y: auto; }
    .history-item { background: rgba(255,255,255,0.02); padding: 8px 12px; border-radius: 6px; border-left: 3px solid var(--neon-purple); display: flex; justify-content: space-between; align-items: center; }
    .history-info { display: flex; flex-direction: column; gap: 2px; overflow: hidden; max-width: 320px; }
    .history-item span.url { font-family: var(--font-mono); font-size: 0.68rem; color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .history-item span.time { font-size: 0.62rem; color: var(--neon-green); font-weight: 600; }
    .empty-history { font-size: 0.78rem; color: var(--text-muted); text-align: center; font-style: italic; padding: 10px 0; }

    /* Footer */
    .footer { text-align: center; margin-top: 2px; }
    .footer .author { font-family: var(--font-display); font-size: 0.95rem; color: var(--neon-cyan); font-weight: 900; letter-spacing: 2px; text-shadow: 0 0 10px rgba(0, 243, 255, 0.4); }
    .footer .sub { font-size: 0.68rem; color: var(--text-muted); font-family: var(--font-mono); margin-top: 2px; }
    
    ::-webkit-scrollbar { width: 5px; } ::-webkit-scrollbar-track { background: transparent; } ::-webkit-scrollbar-thumb { background: rgba(176, 38, 255, 0.3); border-radius: 10px; }
  </style>
</head>
<body>

  <!-- NEURAL MATRIX VERIFICATION OVERLAY (NEW STYLE) -->
  <div id="cf-overlay" class="cf-overlay">
    <div class="cf-box">
      <div class="cf-title">OTORISASI NEURAL MATRIX</div>
      <div class="cf-desc">Konfirmasi Enkripsi & Akses Protokol Keamanan V4.0</div>
      <div class="matrix-btn" id="matrix-trigger">
        <div id="matrix-checkbox" class="matrix-checkbox"></div>
        <div class="matrix-label">Inisialisasi Keamanan Perangkat</div>
      </div>
      <div class="cf-footer-secure">RAMZYY03 Secure Enclave Protocol</div>
    </div>
  </div>

  <!-- MAIN APP -->
  <div id="app-wrapper" class="app-wrapper">
    
    <!-- HUD Header -->
    <div class="hud-header">
      <div class="hud-title">
        <h1>CYBER BYPASS</h1>
