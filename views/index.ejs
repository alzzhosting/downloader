      </div>
      <div class="hud-stats">
        <div class="status-badge"><div class="status-dot"></div>SYS SECURE</div>
        <div class="ping-text" id="ping-monitor">Latency: 12ms</div>
      </div>
    </div>

    <!-- Main Extractor Panel -->
    <div class="panel">
      <div class="panel-header">
        <div class="panel-title">EXTRACTOR MATRIX</div>
      </div>

      <!-- Mode & Engine Options Bar -->
      <div class="options-bar">
        <div class="mode-tabs">
          <button class="tab-btn active" id="tab-single">Single Mode</button>
          <button class="tab-btn" id="tab-batch">Batch Mode</button>
        </div>
        <select class="engine-mode-select" id="engine-mode">
          <option value="auto">Engine: Auto-Detect</option>
          <option value="deep">Engine: Deep Scan Base64</option>
        </select>
      </div>

      <!-- Input Single / Batch with Clipboard Paste Feature -->
      <div id="container-single">
        <div class="input-wrapper">
          <input type="url" class="input-box" id="link-input" placeholder=">> Tempel URL Target di sini..." autocomplete="off">
          <button class="paste-btn" id="btn-paste">PASTE</button>
        </div>
      </div>
      
      <div id="container-batch" style="display: none;">
        <textarea class="input-box" id="batch-input" rows="3" placeholder=">> Tempel banyak link (1 link per baris)&#10;https://sfl.gl/xxx&#10;https://www.mediafire.com/file/xxx"></textarea>
      </div>

      <div class="btn-group">
        <button class="btn btn-main" id="btn-download">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
          EKSTRAK & UNDUH
        </button>
        <button class="btn btn-sec" id="btn-copy" disabled>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          COPY
        </button>
      </div>

      <!-- FITUR BARU: QR CODE PREVIEW SETELAH BERHASIL -->
      <div class="qr-preview-box" id="qr-preview-box">
        <img id="qr-img" class="qr-image" src="" alt="QR">
        <div class="qr-info">
          <span>QR Matrix Generated</span>
          Scan untuk buka link di HP lain.
        </div>
      </div>
    </div>

    <!-- Terminal Console Panel -->
    <div class="panel terminal">
      <div class="panel-header">
        <div class="panel-title" style="color: var(--text-muted);">LIVE NEURAL LOGS</div>
        <span id="clear-term" style="font-size: 0.65rem; cursor: pointer; color: var(--neon-red); font-family: var(--font-mono);">[CLEAR]</span>
      </div>
      <div class="term-window" id="term-window">
        <div class="log-sys">> Neural engine initialized securely. Ready...</div>
      </div>
    </div>

    <!-- History Panel with Export Feature -->
    <div class="panel">
      <div class="history-actions">
        <div class="panel-title" style="margin-bottom:0;">SESSION CACHE</div>
        <div style="display:flex; gap:10px;">
          <button class="clear-history-btn" id="btn-export" style="color:var(--neon-cyan);">[EXPORT .TXT]</button>
          <button class="clear-history-btn" id="clear-history">[CLEAR CACHE]</button>
        </div>
      </div>
      <div class="history-list" id="history-list" style="margin-top:10px;"></div>
    </div>

    <!-- Footer -->
    <footer class="footer">
      <div class="author">AUTHOR RAMZYY03</div>
      <div class="sub">Advanced Decryption Matrix Engine v4.0</div>
    </footer>

  </div>

  <script>
    // --- AUDIO FX SYNTHESIZER (Cyber Sound Effects) ---
    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    function playBeep(freq = 440, type = 'sine', duration = 0.08) {
      try {
        if (audioCtx.state === 'suspended') audioCtx.resume();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = type;
        osc.frequency.value = freq;
        gain.gain.setValueAtTime(0.05, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + duration);
        osc.connect(gain);
        gain.connect(audioCtx.destination);
        osc.start();
        osc.stop(audioCtx.currentTime + duration);
      } catch(e) {}
    }

    // --- NEURAL MATRIX VERIFICATION (NEW PROMPT) ---
    const cfOverlay = document.getElementById('cf-overlay');
    const matrixTrigger = document.getElementById('matrix-trigger');
    const matrixCheckbox = document.getElementById('matrix-checkbox');
    const appWrapper = document.getElementById('app-wrapper');

    matrixTrigger.addEventListener('click', () => {
      if (matrixCheckbox.classList.contains('loading') || matrixCheckbox.classList.contains('success')) return;
      playBeep(600, 'triangle', 0.1);
      matrixCheckbox.classList.add('loading');

      setTimeout(() => {
        playBeep(880, 'sine', 0.15);
        matrixCheckbox.classList.remove('loading');
        matrixCheckbox.classList.add('success');
        matrixCheckbox.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#00ff88" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';

        setTimeout(() => {
          cfOverlay.classList.add('hidden');
          setTimeout(() => {
            cfOverlay.style.display = 'none';
            appWrapper.classList.add('active');
          }, 500);
        }, 600);
      }, 1200);
    });

    // --- PING MONITOR ---
    setInterval(() => {
      const p = Math.floor(Math.random() * (18 - 9 + 1)) + 9;
      document.getElementById('ping-monitor').innerText = `Latency: ${p}ms`;
    }, 4000);

    // --- MODE SWITCHER ---
    const tabSingle = document.getElementById('tab-single');
    const tabBatch = document.getElementById('tab-batch');
    const containerSingle = document.getElementById('container-single');
    const containerBatch = document.getElementById('container-batch');
    let isBatchMode = false;

    tabSingle.addEventListener('click', () => { playBeep(500); tabSingle.classList.add('active'); tabBatch.classList.remove('active'); containerSingle.style.display = 'block'; containerBatch.style.display = 'none'; isBatchMode = false; });
    tabBatch.addEventListener('click', () => { playBeep(500); tabBatch.classList.add('active'); tabSingle.classList.remove('active'); containerSingle.style.display = 'none'; containerBatch.style.display = 'block'; isBatchMode = true; });

    // --- APP LOGIC & NEW FEATURES ---
    const btnDownload = document.getElementById('btn-download');
    const btnCopy = document.getElementById('btn-copy');
    const btnPaste = document.getElementById('btn-paste');
    const linkInput = document.getElementById('link-input');
    const batchInput = document.getElementById('batch-input');
    const termWindow = document.getElementById('term-window');
    const historyList = document.getElementById('history-list');
    const qrBox = document.getElementById('qr-preview-box');
    const qrImg = document.getElementById('qr-img');

    let currentDirectLink = "";

    function addLog(msg, type = "log-sys") {
      const time = new Date().toLocaleTimeString('id-ID', { hour12: false });
      const oldCursor = document.querySelector('.blinking-cursor');
      if (oldCursor) oldCursor.remove();
      const line = document.createElement('div');
      line.className = type;
      line.innerHTML = `[${time}] ${msg} <span class="blinking-cursor"></span>`;
      termWindow.appendChild(line);
      termWindow.scrollTop = termWindow.scrollHeight;
    }

    document.getElementById('clear-term').addEventListener('click', () => {
      playBeep(300);
      termWindow.innerHTML = '<div class="log-sys">> Console cleared. <span class="blinking-cursor"></span></div>';
    });

    const sleep = (ms) => new Promise(res => setTimeout(res, ms));

    // FITUR 1: ONE-TAP CLIPBOARD PASTE
    btnPaste.addEventListener('click', async () => {
      try {
        const text = await navigator.clipboard.readText();
        if (text) {
          linkInput.value = text.trim();
          playBeep(750, 'sine', 0.08);
          addLog("Teks dari Clipboard berhasil ditempel.", "log-succ");
        }
      } catch (err) {
        addLog("ERR: Izinkan akses clipboard pada browser Anda.", "log-err");
      }
    });

    function loadHistory() {
      const h = JSON.parse(localStorage.getItem('mf_history_v4') || '[]');
      historyList.innerHTML = '';
      if (h.length === 0) { historyList.innerHTML = '<div class="empty-history">Belum ada riwayat sesi ini.</div>'; return; }
      h.forEach(item => {
        historyList.innerHTML += `
          <div class="history-item">
            <div class="history-info">
              <span class="time">${item.time} - [${item.type}]</span>
              <span class="url">${item.url}</span>
            </div>
          </div>`;
      });
    }

    function saveHistory(url, type) {
      const h = JSON.parse(localStorage.getItem('mf_history_v4') || '[]');
      const time = new Date().toLocaleTimeString('id-ID', { hour12: false });
      h.unshift({ url, time, type }); 
      if (h.length > 5) h.pop(); 
      localStorage.setItem('mf_history_v4', JSON.stringify(h));
      loadHistory();
    }
    loadHistory();

    // FITUR 2: CLEAR CACHE BUTTON
    document.getElementById('clear-history').addEventListener('click', () => {
      playBeep(300);
      localStorage.removeItem('mf_history_v4');
      loadHistory();
      addLog("Session Cache berhasil dibersihkan.", "log-warn");
    });

    // FITUR 3: EXPORT CACHE TO TXT FILE
    document.getElementById('btn-export').addEventListener('click', () => {
      playBeep(900);
      const h = JSON.parse(localStorage.getItem('mf_history_v4') || '[]');
      if (h.length === 0) {
        addLog("ERR: Cache kosong, tidak ada yang bisa diexport.", "log-err");
        return;
      }
      let content = "=== RAMZYY03 BYPASS SESSION REPORT ===\n\n";
      h.forEach((item, index) => {
        content += `[${index+1}] Waktu: ${item.time}\nTipe: ${item.type}\nURL: ${item.url}\n-----------------------------------\n`;
      });
      const blob = new Blob([content], { type: 'text/plain' });
      const blobUrl = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = blobUrl;
      a.download = `Bypass_Report_${Date.now()}.txt`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      addLog("Laporan session cache berhasil di-export ke .txt", "log-succ");
    });

    async function processBypass(url) {
      const response = await fetch('/api/extract', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url: url })
      });
      return await response.json();
    }

    btnDownload.addEventListener('click', async () => {
      playBeep(700);
      btnCopy.disabled = true;
      currentDirectLink = "";
      qrBox.classList.remove('active');

      if (!isBatchMode) {
        const url = linkInput.value.trim();
        if (!url || !url.startsWith('http')) {
          playBeep(200, 'sawtooth', 0.2);
          addLog("ERR: Masukkan URL target yang valid (http/https).", "log-err");
          return;
        }

        btnDownload.disabled = true;
        btnDownload.innerHTML = 'MEMPROSES...';
        addLog(`Menganalisa target tunggal...`, "log-warn");
        await sleep(600);

        try {
          const data = await processBypass(url);
          await sleep(500);

          if (data.success) {
            currentDirectLink = data.direct_link;
            btnCopy.disabled = false;
            playBeep(1200, 'sine', 0.2);
            
            addLog(`Tipe Protokol: [${data.type}]`, "log-info");
            addLog("Payload decrypter berhasil di-generate!", "log-succ");
            
            // FITUR 4: GENERATE LIVE QR CODE UNTUK DIRECT LINK
            qrImg.src = `https://api.qrserver.com/v1/create-qr-code/?size=100x100&data=${encodeURIComponent(data.direct_link)}`;
            qrBox.classList.add('active');

            saveHistory(url, data.type);

            // Siluman Download via iFrame
            setTimeout(() => {
              const iframe = document.createElement('iframe');
              iframe.style.display = 'none';
              iframe.src = data.direct_link;
              document.body.appendChild(iframe);
              addLog("Unduhan latar belakang aktif!", "log-succ");
            }, 800);

          } else {
            playBeep(200, 'sawtooth', 0.2);
            addLog(`ERR: ${data.message}`, "log-err");
          }
        } catch (err) {
          playBeep(200, 'sawtooth', 0.2);
          addLog("ERR: Gagal terhubung ke server backend.", "log-err");
        } finally {
          btnDownload.disabled = false;
          btnDownload.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg> EKSTRAK & UNDUH`;
        }

      } else {
        // --- BATCH MODE ---
        const rawText = batchInput.value.trim();
        const urls = rawText.split('\n').map(u => u.trim()).filter(u => u.startsWith('http'));

        if (urls.length === 0) {
          playBeep(200, 'sawtooth', 0.2);
          addLog("ERR: Tidak ada URL valid di dalam Batch Box.", "log-err");
          return;
        }

        btnDownload.disabled = true;
        btnDownload.innerHTML = `PROCESSING (${urls.length})...`;
        addLog(`Memulai Batch Engine untuk ${urls.length} target...`, "log-warn");

        for (let i = 0; i < urls.length; i++) {
          const targetUrl = urls[i];
          addLog(`[${i+1}/${urls.length}] Bypass: ${targetUrl.substring(0, 22)}...`, "log-sys");
          
          try {
            const data = await processBypass(targetUrl);
            if (data.success) {
              playBeep(1000, 'sine', 0.1);
              addLog(`[${i+1}] SUCCESS: [${data.type}]`, "log-succ");
              saveHistory(targetUrl, data.type);
              
              setTimeout(() => {
                const iframe = document.createElement('iframe');
                iframe.style.display = 'none';
                iframe.src = data.direct_link;
                document.body.appendChild(iframe);
              }, i * 1200);
            } else {
              addLog(`[${i+1}] FAILED: ${data.message}`, "log-err");
            }
          } catch(e) {
            addLog(`[${i+1}] ERR: Koneksi terputus.`, "log-err");
          }
          await sleep(400);
        }

        addLog("Batch Queue selesai dieksekusi.", "log-succ");
        btnDownload.disabled = false;
        btnDownload.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg> EKSTRAK & UNDUH`;
      }
    });

    btnCopy.addEventListener('click', () => {
      if (currentDirectLink) {
        navigator.clipboard.writeText(currentDirectLink).then(() => {
          playBeep(950, 'sine', 0.1);
          addLog("Direct link berhasil disalin!", "log-succ");
          btnCopy.innerHTML = "COPIED!";
          setTimeout(() => { btnCopy.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg> COPY`; }, 2000);
        }).catch(() => { addLog("ERR: Gagal menyalin clipboard.", "log-err"); });
      }
    });
  </script>
</body>
</html>
