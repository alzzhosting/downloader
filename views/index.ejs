<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>UNIVERSAL BYPASS ENGINE</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600&family=Orbitron:wght@500;700;900&family=Rajdhani:wght@500;600;700&display=swap');

    :root {
      --bg-main: #030305;
      --card-bg: rgba(10, 10, 15, 0.85);
      --neon-cyan: #00f3ff;
      --neon-red: #ff2a2a;
      --neon-green: #00ff88;
      --neon-purple: #b026ff;
      --text-main: #e2e8f0;
      --text-muted: #64748b;
      --border-cyan: rgba(0, 243, 255, 0.2);
      --font-ui: 'Rajdhani', sans-serif;
      --font-mono: 'Fira Code', monospace;
      --font-display: 'Orbitron', sans-serif;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background-color: var(--bg-main); color: var(--text-main); font-family: var(--font-ui);
      min-height: 100vh; display: flex; justify-content: center; align-items: center; overflow-x: hidden;
      background-image: radial-gradient(circle at 10% 20%, rgba(0, 243, 255, 0.05) 0%, transparent 40%), radial-gradient(circle at 90% 80%, rgba(176, 38, 255, 0.05) 0%, transparent 40%);
    }
    body::after {
      content: " "; display: block; position: fixed; top: 0; left: 0; bottom: 0; right: 0;
      background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.06), rgba(0, 255, 0, 0.02), rgba(0, 0, 255, 0.06));
      z-index: 2; background-size: 100% 2px, 3px 100%; pointer-events: none;
    }

    /* CF Overlay */
    .cf-overlay { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: #000; z-index: 9999; display: flex; flex-direction: column; justify-content: center; align-items: center; transition: opacity 0.5s ease; }
    .cf-overlay.hidden { opacity: 0; pointer-events: none; }
    .cf-box { background: #111; border: 1px solid #333; border-radius: 8px; padding: 24px; width: 100%; max-width: 320px; box-shadow: 0 10px 30px rgba(0,0,0,0.8); display: flex; flex-direction: column; gap: 16px; }
    .cf-verify-row { display: flex; align-items: center; gap: 16px; }
    .cf-checkbox { width: 28px; height: 28px; border: 2px solid #555; border-radius: 4px; cursor: pointer; display: flex; justify-content: center; align-items: center; transition: all 0.3s; }
    .cf-checkbox:hover { border-color: #888; }
    .cf-checkbox.loading { border: 2px solid transparent; border-top-color: var(--neon-cyan); border-radius: 50%; animation: cf-spin 1s linear infinite; cursor: default; }
    .cf-checkbox.success { border-color: var(--neon-green); background: rgba(0, 255, 136, 0.1); cursor: default; }
    .cf-text { font-family: sans-serif; font-size: 0.9rem; color: #ccc; }
    .cf-footer { border-top: 1px solid #333; padding-top: 12px; font-size: 0.7rem; color: #666; display: flex; justify-content: space-between; font-family: sans-serif; }
    @keyframes cf-spin { 100% { transform: rotate(360deg); } }

    /* App Wrapper */
    .app-wrapper { width: 100%; max-width: 500px; padding: 20px; z-index: 10; display: none; flex-direction: column; gap: 20px; animation: glitch-in 0.5s cubic-bezier(0.25, 1, 0.5, 1) forwards; }
    .app-wrapper.active { display: flex; }
    @keyframes glitch-in { 0% { opacity: 0; transform: scale(0.95) translateY(20px); filter: blur(10px); } 100% { opacity: 1; transform: scale(1) translateY(0); filter: blur(0); } }

    /* Header */
    .header { text-align: center; padding-bottom: 10px; border-bottom: 1px solid var(--border-cyan); position: relative; }
    .header h1 { font-family: var(--font-display); font-size: 2rem; color: var(--text-main); text-shadow: 0 0 10px var(--neon-purple); letter-spacing: 2px; }
    .header p { color: var(--neon-cyan); font-family: var(--font-mono); font-size: 0.8rem; margin-top: 5px; }
    .badge-auto { position: absolute; top: 10px; right: 0; background: rgba(176, 38, 255, 0.15); border: 1px solid var(--neon-purple); color: var(--neon-purple); font-size: 0.6rem; padding: 4px 8px; border-radius: 12px; font-family: var(--font-mono); font-weight: bold; }

    /* Panels */
    .panel { background: var(--card-bg); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border: 1px solid var(--border-cyan); border-radius: 12px; padding: 20px; box-shadow: inset 0 0 20px rgba(0, 243, 255, 0.02), 0 10px 20px rgba(0,0,0,0.5); position: relative; overflow: hidden; }
    .panel-title { font-family: var(--font-display); font-size: 0.9rem; color: var(--neon-cyan); margin-bottom: 15px; display: flex; align-items: center; gap: 8px; }
    .panel-title::before { content: ''; width: 8px; height: 8px; background: var(--neon-cyan); display: inline-block; box-shadow: 0 0 8px var(--neon-cyan); }

    /* Input & Buttons */
    input[type="url"] { width: 100%; padding: 15px; background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; color: #fff; font-family: var(--font-mono); font-size: 0.85rem; outline: none; transition: all 0.3s; margin-bottom: 15px; }
    input[type="url"]:focus { border-color: var(--neon-cyan); box-shadow: 0 0 15px rgba(0, 243, 255, 0.2); }
    .btn-group { display: flex; gap: 10px; }
    .btn { flex: 1; padding: 14px; border: none; border-radius: 8px; font-family: var(--font-display); font-weight: 700; font-size: 0.9rem; letter-spacing: 1px; cursor: pointer; display: flex; justify-content: center; align-items: center; gap: 8px; transition: all 0.2s; }
    .btn-primary { background: linear-gradient(135deg, var(--neon-purple), #0088ff); color: #fff; box-shadow: 0 0 15px rgba(176, 38, 255, 0.4); text-shadow: 0 2px 4px rgba(0,0,0,0.5); }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 0 25px rgba(176, 38, 255, 0.6); }
    .btn-primary:active { transform: scale(0.95); }
    .btn-primary:disabled { background: #333; color: #666; box-shadow: none; cursor: not-allowed; transform: none; }
    .btn-secondary { background: transparent; border: 1px solid var(--neon-cyan); color: var(--neon-cyan); }
    .btn-secondary:hover { background: rgba(0, 243, 255, 0.1); }
    .btn-secondary:disabled { border-color: #333; color: #555; cursor: not-allowed; }

    /* Terminal */
    .terminal { padding: 15px; background: #050508; border-color: #222; }
    .term-window { height: 140px; overflow-y: auto; font-family: var(--font-mono); font-size: 0.75rem; line-height: 1.5; color: #888; display: flex; flex-direction: column; gap: 4px; }
    .log-sys { color: #888; } .log-warn { color: #f59e0b; } .log-succ { color: var(--neon-green); text-shadow: 0 0 5px rgba(0,255,136,0.5); } .log-err { color: var(--neon-red); text-shadow: 0 0 5px rgba(255,42,42,0.5); } .log-info { color: var(--neon-purple); }
    .blinking-cursor { display: inline-block; width: 6px; height: 12px; background: var(--neon-cyan); animation: blink 1s step-end infinite; margin-left: 5px; }
    @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

    /* History & Footer */
    .history-list { display: flex; flex-direction: column; gap: 8px; max-height: 150px; overflow-y: auto; }
    .history-item { background: rgba(255,255,255,0.03); padding: 10px 12px; border-radius: 6px; border-left: 3px solid var(--neon-purple); display: flex; flex-direction: column; gap: 4px; }
    .history-item span.url { font-family: var(--font-mono); font-size: 0.7rem; color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .history-item span.time { font-size: 0.65rem; color: var(--neon-green); font-weight: 600; }
    .empty-history { font-size: 0.8rem; color: #555; text-align: center; font-style: italic; padding: 10px 0; }
    .footer { text-align: center; margin-top: 10px; }
    .footer .author { font-family: var(--font-display); font-size: 1rem; color: var(--neon-red); font-weight: 900; letter-spacing: 3px; text-shadow: 0 0 10px rgba(255, 42, 42, 0.5); }
    .footer .sub { font-size: 0.75rem; color: #555; font-family: var(--font-mono); margin-top: 4px; }
    ::-webkit-scrollbar { width: 6px; } ::-webkit-scrollbar-track { background: transparent; } ::-webkit-scrollbar-thumb { background: rgba(176, 38, 255, 0.3); border-radius: 10px; }
  </style>
</head>
<body>

  <div id="cf-overlay" class="cf-overlay">
    <div class="cf-box">
      <div class="cf-verify-row">
        <div id="cf-checkbox" class="cf-checkbox"></div>
        <span id="cf-text" class="cf-text">Verify you are human</span>
      </div>
      <div class="cf-footer">
        <span>RAMZYY03 Web Security</span>
        <span>Privacy · Terms</span>
      </div>
    </div>
  </div>

  <div id="app-wrapper" class="app-wrapper">
    <header class="header">
      <div class="badge-auto">AUTO-DETECT ON</div>
      <h1>UNIVERSAL BYPASS</h1>
      <p>MediaFire • Safelink • Bit.ly • S.id</p>
    </header>

    <div class="panel">
      <div class="panel-title">EXTRACT MODULE</div>
      <input type="url" id="link-input" placeholder=">> Tempel target URL di sini..." autocomplete="off">
      <div class="btn-group">
        <button class="btn btn-primary" id="btn-download">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
          UNDUH
        </button>
        <button class="btn btn-secondary" id="btn-copy" disabled>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          COPY
        </button>
      </div>
    </div>

    <div class="panel terminal">
      <div class="panel-title" style="color: #64748b; display: flex; justify-content: space-between;">
        LIVE CONSOLE
        <span id="clear-term" style="font-size: 0.65rem; cursor: pointer; color: var(--neon-red);">[CLEAR]</span>
      </div>
      <div class="term-window" id="term-window">
        <div class="log-sys">> System initialized. Multi-Bypass ready...</div>
      </div>
    </div>

    <div class="panel">
      <div class="panel-title">RECENT BYPASS</div>
      <div class="history-list" id="history-list"></div>
    </div>

    <footer class="footer">
      <div class="author">AUTHOR RAMZYY03</div>
      <div class="sub">Advanced Encryption Standard V2.0</div>
    </footer>
  </div>

  <script>
    // VERIFICATION UI
    const cfOverlay = document.getElementById('cf-overlay');
    const cfCheckbox = document.getElementById('cf-checkbox');
    const cfText = document.getElementById('cf-text');
    const appWrapper = document.getElementById('app-wrapper');

    cfCheckbox.addEventListener('click', () => {
      if (cfCheckbox.classList.contains('loading') || cfCheckbox.classList.contains('success')) return;
      cfCheckbox.classList.add('loading');
      cfText.innerText = "Verifying secure connection...";
      cfText.style.color = "#00f3ff";

      setTimeout(() => {
        cfCheckbox.classList.remove('loading');
        cfCheckbox.classList.add('success');
        cfCheckbox.innerHTML = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00ff88" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';
        cfText.innerText = "Verification complete.";
        cfText.style.color = "#00ff88";

        setTimeout(() => {
          cfOverlay.classList.add('hidden');
          setTimeout(() => {
            cfOverlay.style.display = 'none';
            appWrapper.classList.add('active');
          }, 500);
        }, 800);
      }, 1500);
    });

    // MAIN APP
    const btnDownload = document.getElementById('btn-download');
    const btnCopy = document.getElementById('btn-copy');
    const linkInput = document.getElementById('link-input');
    const termWindow = document.getElementById('term-window');
    const historyList = document.getElementById('history-list');

    let currentDirectLink = "";

    function addLog(msg, type = "log-sys") {
      const time = new Date().toLocaleTimeString('id-ID', { hour12: false });
      const oldCursor = document.querySelector('.blinking-cursor');
      if (oldCursor) oldCursor.remove();
      const line = document.createElement('div');
      line.className = type;
      line.innerHTML = `[${time}] ${msg} <span class="blinking-cursor"></span>`;
      termWindow.appendChild(line);
      termWindow.scrollTop = termWindow.scrollHeight;
    }

    document.getElementById('clear-term').addEventListener('click', () => {
      termWindow.innerHTML = '<div class="log-sys">> Console cleared. <span class="blinking-cursor"></span></div>';
    });

    const sleep = (ms) => new Promise(res => setTimeout(res, ms));

    function loadHistory() {
      const h = JSON.parse(localStorage.getItem('mf_history_v2') || '[]');
      historyList.innerHTML = '';
      if (h.length === 0) { historyList.innerHTML = '<div class="empty-history">Belum ada riwayat sesi ini.</div>'; return; }
      h.forEach(item => {
        historyList.innerHTML += `<div class="history-item"><span class="time">${item.time} - ${item.type}</span><span class="url">${item.url}</span></div>`;
      });
    }

    function saveHistory(url, type) {
      const h = JSON.parse(localStorage.getItem('mf_history_v2') || '[]');
      const time = new Date().toLocaleTimeString('id-ID', { hour12: false });
      h.unshift({ url, time, type }); 
      if (h.length > 3) h.pop(); 
      localStorage.setItem('mf_history_v2', JSON.stringify(h));
      loadHistory();
    }
    loadHistory();

    btnDownload.addEventListener('click', async () => {
      const url = linkInput.value.trim();
      currentDirectLink = "";
      btnCopy.disabled = true;

      if (!url || !url.startsWith('http')) {
        addLog("ERR: URL tidak valid. Harus diawali http/https.", "log-err");
        return;
      }

      btnDownload.disabled = true;
      btnDownload.innerHTML = 'MEMPROSES...';
      
      addLog(`Menganalisa enkripsi pada URL...`, "log-warn");
      await sleep(800);
      addLog("Mengirim instruksi Deep Scan ke Server Node.js...", "log-sys");

      try {
        const response = await fetch('/api/extract', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url: url })
        });

        const data = await response.json();
        await sleep(600);

        if (data.success) {
          currentDirectLink = data.direct_link;
          btnCopy.disabled = false;
          
          addLog(`Protokol Terdeteksi: [${data.type}]`, "log-info");
          addLog("Bypass Payload berhasil didapatkan!", "log-succ");
          addLog("Memaksa browser melakukan unduhan di latar belakang...", "log-sys");
          
          saveHistory(url, data.type);

          // TRIK SILUMAN (IFRAME) - Memaksa unduhan tanpa memindahkan halaman UI
          setTimeout(() => {
            const iframe = document.createElement('iframe');
            iframe.style.display = 'none';
            iframe.src = data.direct_link;
            document.body.appendChild(iframe);
            addLog("Download dimulai! Cek notifikasi HP Anda.", "log-succ");
          }, 1000);

        } else {
          addLog(`ERR: ${data.message}`, "log-err");
        }
      } catch (err) {
        addLog("ERR: Koneksi API Backend terputus.", "log-err");
      } finally {
        setTimeout(() => {
          btnDownload.disabled = false;
          btnDownload.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg> UNDUH`;
        }, 1500);
      }
    });

    btnCopy.addEventListener('click', () => {
      if (currentDirectLink) {
        navigator.clipboard.writeText(currentDirectLink).then(() => {
          addLog("Direct link disalin ke Clipboard!", "log-succ");
          btnCopy.innerHTML = "COPIED!";
          setTimeout(() => { btnCopy.innerHTML = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg> COPY`; }, 2000);
        }).catch(() => { addLog("ERR: Gagal menyalin teks.", "log-err"); });
      }
    });
  </script>
</body>
</html>
