<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CYBER BYPASS ENGINE V3.0 - by Ramzyy03</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600&family=Orbitron:wght@500;700;900&family=Rajdhani:wght@500;600;700&display=swap');

    :root {
      --bg-main: #020205;
      --card-bg: rgba(12, 12, 20, 0.75);
      --neon-cyan: #00f3ff;
      --neon-purple: #b026ff;
      --neon-green: #00ff88;
      --neon-red: #ff2a2a;
      --text-main: #f1f5f9;
      --text-muted: #64748b;
      --border-glow: rgba(176, 38, 255, 0.25);
      --font-ui: 'Rajdhani', sans-serif;
      --font-mono: 'Fira Code', monospace;
      --font-display: 'Orbitron', sans-serif;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background-color: var(--bg-main);
      color: var(--text-main);
      font-family: var(--font-ui);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow-x: hidden;
      background-image: 
        radial-gradient(circle at 20% 20%, rgba(176, 38, 255, 0.08) 0%, transparent 40%),
        radial-gradient(circle at 80% 80%, rgba(0, 243, 255, 0.08) 0%, transparent 40%);
    }

    /* Cyber Scanline */
    body::after {
      content: " "; display: block; position: fixed; top: 0; left: 0; bottom: 0; right: 0;
      background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.3) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.03), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.03));
      z-index: 2; background-size: 100% 3px, 3px 100%; pointer-events: none;
    }

    /* --- CYBER CAPTCHA OVERLAY --- */
    .cf-overlay {
      position: fixed; top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(2, 2, 5, 0.95); backdrop-filter: blur(12px);
      z-index: 9999; display: flex; flex-direction: column; justify-content: center; align-items: center;
      transition: opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .cf-overlay.hidden { opacity: 0; pointer-events: none; }
    
    .cf-box {
      background: linear-gradient(135deg, rgba(20, 20, 30, 0.9), rgba(10, 10, 15, 0.95));
      border: 1px solid var(--neon-purple);
      border-radius: 16px; padding: 30px; width: 100%; max-width: 360px;
      box-shadow: 0 0 30px rgba(176, 38, 255, 0.2), inset 0 0 15px rgba(176, 38, 255, 0.05);
      display: flex; flex-direction: column; gap: 20px; text-align: center;
      position: relative; overflow: hidden;
    }
    .cf-box::before {
      content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 2px;
      background: linear-gradient(90deg, transparent, var(--neon-cyan), var(--neon-purple), transparent);
      animation: scan-line 2s linear infinite;
    }
    @keyframes scan-line { 0% { transform: translateX(-100%); } 100% { transform: translateX(100%); } }

    .cf-title { font-family: var(--font-display); font-size: 0.95rem; color: var(--neon-cyan); letter-spacing: 1px; }
    .cf-desc { font-size: 0.8rem; color: var(--text-muted); font-family: var(--font-mono); }
    
    .matrix-btn {
      background: rgba(0, 243, 255, 0.05); border: 1px solid var(--neon-cyan);
      border-radius: 10px; padding: 15px; display: flex; align-items: center; gap: 15px;
      cursor: pointer; transition: all 0.3s;
    }
    .matrix-btn:hover { background: rgba(0, 243, 255, 0.15); box-shadow: 0 0 15px rgba(0, 243, 255, 0.3); }
    
    .matrix-checkbox {
      width: 26px; height: 26px; border: 2px solid var(--neon-cyan); border-radius: 6px;
      display: flex; justify-content: center; align-items: center; position: relative;
    }
    .matrix-checkbox.loading { border-color: transparent; border-top-color: var(--neon-purple); animation: spin 0.8s linear infinite; }
    .matrix-checkbox.success { border-color: var(--neon-green); background: rgba(0, 255, 136, 0.2); box-shadow: 0 0 10px var(--neon-green); }
    @keyframes spin { 100% { transform: rotate(360deg); } }
    
    .matrix-label { font-family: var(--font-ui); font-size: 1rem; font-weight: 600; color: #fff; text-align: left; }
    .cf-footer-secure { font-size: 0.7rem; color: var(--text-muted); font-family: var(--font-mono); border-top: 1px solid rgba(255,255,255,0.05); padding-top: 12px; }

    /* --- MAIN APP WRAPPER --- */
    .app-wrapper {
      width: 100%; max-width: 520px; padding: 20px; z-index: 10;
      display: none; flex-direction: column; gap: 18px;
      animation: zoom-in 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .app-wrapper.active { display: flex; }
    @keyframes zoom-in { 0% { opacity: 0; transform: scale(0.92); filter: blur(8px); } 100% { opacity: 1; transform: scale(1); filter: blur(0); } }

    /* Header HUD */
    .hud-header {
      background: var(--card-bg); backdrop-filter: blur(16px);
      border: 1px solid var(--border-glow); border-radius: 14px; padding: 18px 22px;
      display: flex; justify-content: space-between; align-items: center;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }
    .hud-title h1 { font-family: var(--font-display); font-size: 1.4rem; color: #fff; letter-spacing: 1px; text-shadow: 0 0 10px rgba(176, 38, 255, 0.5); }
    .hud-title p { font-size: 0.75rem; color: var(--neon-cyan); font-family: var(--font-mono); }
    
    .hud-stats { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; }
    .status-badge { display: flex; align-items: center; gap: 6px; font-size: 0.7rem; font-family: var(--font-mono); color: var(--neon-green); background: rgba(0, 255, 136, 0.1); padding: 3px 8px; border-radius: 20px; border: 1px solid rgba(0, 255, 136, 0.3); }
    .status-dot { width: 6px; height: 6px; background: var(--neon-green); border-radius: 50%; box-shadow: 0 0 8px var(--neon-green); animation: pulse 1.5s infinite; }
    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }
    .ping-text { font-size: 0.65rem; color: var(--text-muted); font-family: var(--font-mono); }

    /* Panels */
    .panel {
      background: var(--card-bg); backdrop-filter: blur(16px);
      border: 1px solid var(--border-glow); border-radius: 14px; padding: 20px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5); position: relative;
    }
    .panel-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
    .panel-title { font-family: var(--font-display); font-size: 0.85rem; color: var(--neon-cyan); display: flex; align-items: center; gap: 8px; }
    .panel-title::before { content: ''; width: 6px; height: 6px; background: var(--neon-cyan); border-radius: 50%; box-shadow: 0 0 8px var(--neon-cyan); }

    /* Mode Switcher Tabs */
    .mode-tabs { display: flex; background: rgba(0,0,0,0.4); border-radius: 8px; padding: 3px; border: 1px solid rgba(255,255,255,0.05); margin-bottom: 15px; }
    .tab-btn { flex: 1; background: transparent; border: none; color: var(--text-muted); font-family: var(--font-ui); font-weight: 600; font-size: 0.8rem; padding: 6px; border-radius: 6px; cursor: pointer; transition: all 0.3s; }
    .tab-btn.active { background: var(--neon-purple); color: #fff; box-shadow: 0 0 10px rgba(176, 38, 255, 0.4); }

    /* Inputs & Textarea */
    .input-box {
      width: 100%; padding: 14px; background: rgba(0,0,0,0.6); border: 1px solid rgba(255,255,255,0.1);
      border-radius: 10px; color: #fff; font-family: var(--font-mono); font-size: 0.82rem; outline: none; transition: all 0.3s; resize: none;
    }
    .input-box:focus { border-color: var(--neon-purple); box-shadow: 0 0 15px rgba(176, 38, 255, 0.25); }

    .btn-group { display: flex; gap: 10px; margin-top: 12px; }
    .btn {
      flex: 1; padding: 14px; border: none; border-radius: 10px; font-family: var(--font-display);
      font-weight: 700; font-size: 0.85rem; letter-spacing: 1px; cursor: pointer; display: flex;
      justify-content: center; align-items: center; gap: 8px; transition: all 0.25s;
    }
    .btn-main { background: linear-gradient(135deg, var(--neon-purple), #6366f1); color: #fff; box-shadow: 0 0 20px rgba(176, 38, 255, 0.4); }
    .btn-main:hover { transform: translateY(-2px); box-shadow: 0 0 25px rgba(176, 38, 255, 0.7); }
    .btn-main:active { transform: scale(0.97); }
    .btn-main:disabled { background: #222; color: #555; box-shadow: none; cursor: not-allowed; transform: none; }

    .btn-sec { background: transparent; border: 1px solid var(--neon-cyan); color: var(--neon-cyan); }
    .btn-sec:hover { background: rgba(0, 243, 255, 0.1); }
    .btn-sec:disabled { border-color: #222; color: #555; cursor: not-allowed; }

    /* Terminal Console */
    .terminal { background: #010103; border-color: rgba(0, 243, 255, 0.15); }
    .term-window { height: 130px; overflow-y: auto; font-family: var(--font-mono); font-size: 0.73rem; line-height: 1.5; color: var(--text-muted); display: flex; flex-direction: column; gap: 4px; }
    .log-sys { color: #888; } .log-warn { color: #f59e0b; } .log-succ { color: var(--neon-green); text-shadow: 0 0 6px rgba(0,255,136,0.4); } .log-err { color: var(--neon-red); text-shadow: 0 0 6px rgba(255,42,42,0.4); } .log-info { color: var(--neon-cyan); }
    .blinking-cursor { display: inline-block; width: 5px; height: 11px; background: var(--neon-cyan); animation: blink 1s step-end infinite; margin-left: 4px; }
    @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

    /* History List */
    .history-list { display: flex; flex-direction: column; gap: 6px; max-height: 130px; overflow-y: auto; }
    .history-item { background: rgba(255,255,255,0.02); padding: 8px 12px; border-radius: 6px; border-left: 3px solid var(--neon-purple); display: flex; justify-content: space-between; align-items: center; }
    .history-info { display: flex; flex-direction: column; gap: 2px; overflow: hidden; max-width: 320px; }
    .history-item span.url { font-family: var(--font-mono); font-size: 0.68rem; color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .history-item span.time { font-size: 0.62rem; color: var(--neon-green); font-weight: 600; }
    .empty-history { font-size: 0.78rem; color: var(--text-muted); text-align: center; font-style: italic; padding: 10px 0; }

    /* Footer */
    .footer { text-align: center; margin-top: 5px; }
    .footer .author { font-family: var(--font-display); font-size: 0.95rem; color: var(--neon-cyan); font-weight: 900; letter-spacing: 2px; text-shadow: 0 0 10px rgba(0, 243, 255, 0.4); }
    .footer .sub { font-size: 0.7rem; color: var(--text-muted); font-family: var(--font-mono); margin-top: 2px; }
    
    ::-webkit-scrollbar { width: 5px; } ::-webkit-scrollbar-track { background: transparent; } ::-webkit-scrollbar-thumb { background: rgba(176, 38, 255, 0.3); border-radius: 10px; }
  </style>
</head>
<body>

  <!-- CYBER CAPTCHA OVERLAY -->
  <div id="cf-overlay" class="cf-overlay">
    <div class="cf-box">
      <div class="cf-title">NEURAL SECURITY GATE</div>
      <div class="cf-desc">Verifikasi integritas perangkat untuk membuka akses mesin bypass.</div>
      <div class="matrix-btn" id="matrix-trigger">
        <div id="matrix-checkbox" class="matrix-checkbox"></div>
        <div class="matrix-label">Saya bukan bot otomatis</div>
      </div>
      <div class="cf-footer-secure">RAMZYY03 Secure Enclave Protocol</div>
    </div>
  </div>

  <!-- MAIN APP -->
  <div id="app-wrapper" class="app-wrapper">
    
    <!-- HUD Header -->
    <div class="hud-header">
      <div class="hud-title">
        <h1>CYBER BYPASS</h1>
        <p>Universal Link Decrypter</p>
      </div>
      <div class="hud-stats">
        <div class="status-badge"><div class="status-dot"></div>SYS ONLINE</div>
        <div class="ping-text" id="ping-monitor">Latency: 14ms</div>
      </div>
    </div>

    <!-- Main Extractor Panel -->
    <div class="panel">
      <div class="panel-header">
        <div class="panel-title">EXTRACTOR MATRIX</div>
      </div>

      <!-- Mode Switcher -->
      <div class="mode-tabs">
        <button class="tab-btn active" id="tab-single">Single Link Mode</button>
        <button class="tab-btn" id="tab-batch">Batch Mode (Multi-Link)</button>
      </div>

      <!-- Input Single / Batch -->
      <div id="container-single">
        <input type="url" class="input-box" id="link-input" placeholder=">> Tempel URL Target (MediaFire / Safelink / Bit.ly)..." autocomplete="off">
      </div>
      <div id="container-batch" style="display: none;">
        <textarea class="input-box" id="batch-input" rows="3" placeholder=">> Tempel banyak link di sini&#10;https://sfl.gl/xxx&#10;https://www.mediafire.com/file/xxx"></textarea>
      </div>

      <div class="btn-group">
        <button class="btn btn-main" id="btn-download">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
          EKSTRAK & UNDUH
        </button>
        <button class="btn btn-sec" id="btn-copy" disabled>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          COPY
        </button>
      </div>
    </div>

    <!-- Terminal Console Panel -->
    <div class="panel terminal">
      <div class="panel-header">
        <div class="panel-title" style="color: var(--text-muted);">LIVE NEURAL LOGS</div>
        <span id="clear-term" style="font-size: 0.65rem; cursor: pointer; color: var(--neon-red); font-family: var(--font-mono);">[CLEAR]</span>
      </div>
      <div class="term-window" id="term-window">
        <div class="log-sys">> Neural engine initialized successfully. Ready for input...</div>
      </div>
    </div>

    <!-- History Panel -->
    <div class="panel">
      <div class="panel-header">
        <div class="panel-title">SESSION CACHE</div>
      </div>
      <div class="history-list" id="history-list"></div>
    </div>

    <!-- Footer -->
    <footer class="footer">
      <div class="author">AUTHOR RAMZYY03</div>
      <div class="sub">Advanced Decryption Matrix Engine v3.0</div>
    </footer>

  </div>

  <script>
    // --- VERIFICATION MATRIX SCRIPT ---
    const cfOverlay = document.getElementById('cf-overlay');
    const matrixTrigger = document.getElementById('matrix-trigger');
    const matrixCheckbox = document.getElementById('matrix-checkbox');
    const appWrapper = document.getElementById('app-wrapper');

    matrixTrigger.addEventListener('click', () => {
      if (matrixCheckbox.classList.contains('loading') || matrixCheckbox.classList.contains('success')) return;
      matrixCheckbox.classList.add('loading');

      setTimeout(() => {
        matrixCheckbox.classList.remove('loading');
        matrixCheckbox.classList.add('success');
        matrixCheckbox.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#00ff88" stroke-width="3" stroke-linecap="round"><polyline points="20 6 9 17 4 12"></polyline></svg>';

        setTimeout(() => {
          cfOverlay.classList.add('hidden');
          setTimeout(() => {
            cfOverlay.style.display = 'none';
            appWrapper.classList.add('active');
          }, 500);
        }, 600);
      }, 1200);
    });

    // --- PING MONITOR SIMULATOR ---
    setInterval(() => {
      const randomPing = Math.floor(Math.random() * (22 - 12 + 1)) + 12;
      document.getElementById('ping-monitor').innerText = `Latency: ${randomPing}ms`;
    }, 4000);

    // --- MODE SWITCHER (SINGLE VS BATCH) ---
    const tabSingle = document.getElementById('tab-single');
    const tabBatch = document.getElementById('tab-batch');
    const containerSingle = document.getElementById('container-single');
    const containerBatch = document.getElementById('container-batch');
    let isBatchMode = false;

    tabSingle.addEventListener('click', () => {
      tabSingle.classList.add('active');
      tabBatch.classList.remove('active');
      containerSingle.style.display = 'block';
      containerBatch.style.display = 'none';
      isBatchMode = false;
    });

    tabBatch.addEventListener('click', () => {
      tabBatch.classList.add('active');
      tabSingle.classList.remove('active');
      containerSingle.style.display = 'none';
      containerBatch.style.display = 'block';
      isBatchMode = true;
    });

    // --- APP LOGIC ---
    const btnDownload = document.getElementById('btn-download');
    const btnCopy = document.getElementById('btn-copy');
    const linkInput = document.getElementById('link-input');
    const batchInput = document.getElementById('batch-input');
    const termWindow = document.getElementById('term-window');
    const historyList = document.getElementById('history-list');

    let currentDirectLink = "";

    function addLog(msg, type = "log-sys") {
      const time = new Date().toLocaleTimeString('id-ID', { hour12: false });
      const oldCursor = document.querySelector('.blinking-cursor');
      if (oldCursor) oldCursor.remove();
      const line = document.createElement('div');
      line.className = type;
      line.innerHTML = `[${time}] ${msg} <span class="blinking-cursor"></span>`;
      termWindow.appendChild(line);
      termWindow.scrollTop = termWindow.scrollHeight;
    }

    document.getElementById('clear-term').addEventListener('click', () => {
      termWindow.innerHTML = '<div class="log-sys">> Console cleared. <span class="blinking-cursor"></span></div>';
    });

    const sleep = (ms) => new Promise(res => setTimeout(res, ms));

    function loadHistory() {
      const h = JSON.parse(localStorage.getItem('mf_history_v3') || '[]');
      historyList.innerHTML = '';
      if (h.length === 0) { historyList.innerHTML = '<div class="empty-history">Belum ada riwayat sesi ini.</div>'; return; }
      h.forEach(item => {
        historyList.innerHTML += `
          <div class="history-item">
            <div class="history-info">
              <span class="time">${item.time} - [${item.type}]</span>
              <span class="url">${item.url}</span>
            </div>
          </div>`;
      });
    }

    function saveHistory(url, type) {
      const h = JSON.parse(localStorage.getItem('mf_history_v3') || '[]');
      const time = new Date().toLocaleTimeString('id-ID', { hour12: false });
      h.unshift({ url, time, type }); 
      if (h.length > 3) h.pop(); 
      localStorage.setItem('mf_history_v3', JSON.stringify(h));
      loadHistory();
    }
    loadHistory();

    // Fungsi Eksekusi Bypass
    async function processBypass(url) {
      const response = await fetch('/api/extract', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ url: url })
      });
      return await response.json();
    }

    btnDownload.addEventListener('click', async () => {
      btnCopy.disabled = true;
      currentDirectLink = "";

      if (!isBatchMode) {
        // --- SINGLE MODE ---
        const url = linkInput.value.trim();
        if (!url || !url.startsWith('http')) {
          addLog("ERR: Masukkan URL target yang valid (http/https).", "log-err");
          return;
        }

        btnDownload.disabled = true;
        btnDownload.innerHTML = 'MEMPROSES...';
        addLog(`Menganalisa target tunggal...`, "log-warn");
        await sleep(600);

        try {
          const data = await processBypass(url);
          await sleep(500);

          if (data.success) {
            currentDirectLink = data.direct_link;
            btnCopy.disabled = false;
            addLog(`Tipe Protokol: [${data.type}]`, "log-info");
            addLog("Payload decrypter berhasil di-generate!", "log-succ");
            addLog("Memanggil hidden iframe untuk unduhan siluman...", "log-sys");
            
            saveHistory(url, data.type);

            // Siluman Download via iFrame
            setTimeout(() => {
              const iframe = document.createElement('iframe');
              iframe.style.display = 'none';
              iframe.src = data.direct_link;
              document.body.appendChild(iframe);
              addLog("Unduhan latar belakang aktif!", "log-succ");
            }, 800);

          } else {
            addLog(`ERR: ${data.message}`, "log-err");
          }
        } catch (err) {
          addLog("ERR: Gagal terhubung ke server backend.", "log-err");
        } finally {
          btnDownload.disabled = false;
          btnDownload.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg> EKSTRAK & UNDUH`;
        }

      } else {
        // --- BATCH MODE (MULTI-LINK) ---
        const rawText = batchInput.value.trim();
        const urls = rawText.split('\n').map(u => u.trim()).filter(u => u.startsWith('http'));

        if (urls.length === 0) {
          addLog("ERR: Tidak ada URL valid di dalam Batch Box.", "log-err");
          return;
        }

        btnDownload.disabled = true;
        btnDownload.innerHTML = `PROCESSING (${urls.length})...`;
        addLog(`Memulai Batch Engine untuk ${urls.length} target...`, "log-warn");

        for (let i = 0; i < urls.length; i++) {
          const targetUrl = urls[i];
          addLog(`[${i+1}/${urls.length}] Bypass: ${targetUrl.substring(0, 25)}...`, "log-sys");
          
          try {
            const data = await processBypass(targetUrl);
            if (data.success) {
              addLog(`[${i+1}] SUCCESS: [${data.type}]`, "log-succ");
              saveHistory(targetUrl, data.type);
              
              // Trigger auto download berjarak tipis agar tidak bentrok
              setTimeout(() => {
                const iframe = document.createElement('iframe');
                iframe.style.display = 'none';
                iframe.src = data.direct_link;
                document.body.appendChild(iframe);
              }, i * 1200);
            } else {
              addLog(`[${i+1}] FAILED: ${data.message}`, "log-err");
            }
          } catch(e) {
            addLog(`[${i+1}] ERR: Koneksi terputus.`, "log-err");
          }
          await sleep(500);
        }

        addLog("Batch Queue selesai dieksekusi.", "log-succ");
        btnDownload.disabled = false;
        btnDownload.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg> EKSTRAK & UNDUH`;
      }
    });

    btnCopy.addEventListener('click', () => {
      if (currentDirectLink) {
        navigator.clipboard.writeText(currentDirectLink).then(() => {
          addLog("Direct link berhasil disalin!", "log-succ");
          btnCopy.innerHTML = "COPIED!";
          setTimeout(() => { btnCopy.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg> COPY`; }, 2000);
        }).catch(() => { addLog("ERR: Gagal menyalin clipboard.", "log-err"); });
      }
    });
  </script>
