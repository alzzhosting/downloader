  <script>
    // --- MATRIX RAIN ANIMATION ---
    const canvas = document.getElementById('matrix-canvas');
    const ctx = canvas.getContext('2d');
    function resizeCanvas() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
    window.addEventListener('resize', resizeCanvas);
    resizeCanvas();

    const letters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%^&*()_+-=[]{}|;:,.<>?";
    const fontSize = 14;
    let columns = canvas.width / fontSize;
    const drops = [];
    for (let x = 0; x < columns; x++) drops[x] = 1;

    function drawMatrix() {
      ctx.fillStyle = 'rgba(1, 1, 4, 0.08)';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.fillStyle = '#00f3ff';
      ctx.font = fontSize + 'px monospace';
      for (let i = 0; i < drops.length; i++) {
        const text = letters.charAt(Math.floor(Math.random() * letters.length));
        ctx.fillText(text, i * fontSize, drops[i] * fontSize);
        if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) drops[i] = 0;
        drops[i]++;
      }
    }
    setInterval(drawMatrix, 35);

    // --- AUDIO SYNTHESIZER (SFX BEEP) ---
    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    function playBeep(freq = 440, type = 'sine', duration = 0.08) {
      if (!document.getElementById('toggle-sound').checked) return;
      try {
        if (audioCtx.state === 'suspended') audioCtx.resume();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = type; osc.frequency.value = freq;
        gain.gain.setValueAtTime(0.04, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + duration);
        osc.connect(gain); gain.connect(audioCtx.destination);
        osc.start(); osc.stop(audioCtx.currentTime + duration);
      } catch(e) {}
    }

    function setTheme(themeName) { document.body.className = themeName; playBeep(650, 'sine', 0.05); }

    // --- CAPTCHA LOGIC ---
    let currentCaptchaCode = "";
    const captchaCodeText = document.getElementById('captcha-code-text');
    const captchaInput = document.getElementById('captcha-input');
    const cfOverlay = document.getElementById('cf-overlay');
    const appWrapper = document.getElementById('app-wrapper');

    function generateCaptcha() {
      const chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
      let code = "";
      for (let i = 0; i < 4; i++) code += chars.charAt(Math.floor(Math.random() * chars.length));
      currentCaptchaCode = code; captchaCodeText.innerText = code;
    }
    generateCaptcha();

    document.getElementById('btn-refresh-captcha').addEventListener('click', () => { playBeep(400); generateCaptcha(); });
    document.getElementById('btn-verify-captcha').addEventListener('click', () => {
      if (captchaInput.value.trim().toUpperCase() === currentCaptchaCode) {
        playBeep(900, 'sine', 0.15);
        cfOverlay.classList.add('hidden');
        setTimeout(() => { cfOverlay.style.display = 'none'; appWrapper.classList.add('active'); }, 500);
      } else {
        playBeep(200, 'sawtooth', 0.2);
        captchaInput.style.borderColor = '#ff2a2a'; captchaInput.value = "";
        captchaInput.placeholder = "KODE SALAH!";
        setTimeout(() => { captchaInput.style.borderColor = 'rgba(255,255,255,0.1)'; }, 1000);
      }
    });

    // --- SUB-TABS MANAGER (History, Favorites, Clip Stack) ---
    let activeSubTab = 'history';
    function switchSubTab(tab) {
      playBeep(550);
      activeSubTab = tab;
      document.querySelectorAll('.sub-tab-btn').forEach(b => b.classList.remove('active'));
      document.getElementById('subtab-' + tab).classList.add('active');
      renderDynamicList();
    }

    function getStorageData(key) { return JSON.parse(localStorage.getItem(key) || '[]'); }
    function setStorageData(key, data) { localStorage.setItem(key, JSON.stringify(data)); }

    function renderDynamicList() {
      const container = document.getElementById('dynamic-list-container');
      container.innerHTML = '';
      
      if (activeSubTab === 'history') {
        const h = getStorageData('mf_history_v6');
        document.getElementById('stats-counter').innerText = `Saved: ${h.length} Links`;
        if (h.length === 0) { container.innerHTML = '<div class="empty-msg">Belum ada riwayat sesi.</div>'; return; }
        h.forEach((item, idx) => {
          container.innerHTML += `
            <div class="list-item">
              <div class="list-item-info">
                <span class="meta">${item.time} - [${item.type}]</span>
                <span class="url">${item.url}</span>
              </div>
              <div style="display:flex; gap:6px;">
                <span class="action-link-btn" onclick="addToFav('${item.url}')">⭐</span>
                <span class="action-link-btn" style="color:var(--neon-red);" onclick="deleteHistory(${idx})">DEL</span>
              </div>
            </div>`;
        });
      } else if (activeSubTab === 'fav') {
        const favs = getStorageData('mf_favs_v6');
        if (favs.length === 0) { container.innerHTML = '<div class="empty-msg">Belum ada link favorit tersimpan.</div>'; return; }
        favs.forEach((url, idx) => {
          container.innerHTML += `
            <div class="list-item">
              <div class="list-item-info">
                <span class="meta">FAVOURITE LINK</span>
                <span class="url">${url}</span>
              </div>
              <span class="action-link-btn" style="color:var(--neon-red);" onclick="deleteFav(${idx})">DEL</span>
            </div>`;
        });
      } else if (activeSubTab === 'clip') {
        const clips = getStorageData('mf_clips_v6');
        if (clips.length === 0) { container.innerHTML = '<div class="empty-msg">Clipboard stack kosong.</div>'; return; }
        clips.forEach((clip, idx) => {
          container.innerHTML += `
            <div class="list-item" onclick="document.getElementById('link-input').value='${clip}'; switchSubTab('history');">
              <div class="list-item-info">
                <span class="meta">CLIPBOARD MEMORY #${idx+1}</span>
                <span class="url">${clip}</span>
              </div>
            </div>`;
        });
      }
    }
    renderDynamicList();

    function addToFav(url) {
      const favs = getStorageData('mf_favs_v6');
      if (!favs.includes(url)) { favs.push(url); setStorageData('mf_favs_v6', favs); playBeep(800); addLog("Ditambahkan ke Favorites ⭐", "log-succ"); }
    }
    function deleteHistory(idx) { const h = getStorageData('mf_history_v6'); h.splice(idx, 1); setStorageData('mf_history_v6', h); renderDynamicList(); }
    function deleteFav(idx) { const f = getStorageData('mf_favs_v6'); f.splice(idx, 1); setStorageData('mf_favs_v6', f); renderDynamicList(); }

    // --- APP LOGIC & UTILITIES ---
    const btnDownload = document.getElementById('btn-download');
    const btnCopy = document.getElementById('btn-copy');
    const linkInput = document.getElementById('link-input');
    const batchInput = document.getElementById('batch-input');
    const termWindow = document.getElementById('term-window');
    const qrBox = document.getElementById('qr-preview-box');
    const qrImg = document.getElementById('qr-img');
    const benchmarkInfo = document.getElementById('benchmark-info');
    let currentDirectLink = "";

    function addLog(msg, type = "log-sys") {
      const time = new Date().toLocaleTimeString('id-ID', { hour12: false });
      const oldCursor = document.querySelector('.blinking-cursor');
      if (oldCursor) oldCursor.remove();
      const line = document.createElement('div');
      line.className = type;
      line.innerHTML = `[${time}] ${msg} <span class="blinking-cursor"></span>`;
      termWindow.appendChild(line);
      termWindow.scrollTop = termWindow.scrollHeight;
    }

    document.getElementById('clear-term').addEventListener('click', () => { playBeep(300); termWindow.innerHTML = '<div class="log-sys">> Console cleared. <span class="blinking-cursor"></span></div>'; });
    document.getElementById('btn-fullscreen-term').addEventListener('click', () => {
      const box = document.getElementById('terminal-box');
      box.classList.toggle('fullscreen');
      document.getElementById('btn-fullscreen-term').innerText = box.classList.contains('fullscreen') ? '[RESTORE]' : '[FULLSCREEN]';
    });

    const sleep = (ms) => new Promise(res => setTimeout(res, ms));

    // One-Tap Paste & Clip Stack recorder
    document.getElementById('btn-paste').addEventListener('click', async () => {
      try {
        const text = await navigator.clipboard.readText();
        if (text) {
          linkInput.value = text.trim();
          playBeep(750, 'sine', 0.08);
          const clips = getStorageData('mf_clips_v6');
          if (!clips.includes(text.trim())) { clips.unshift(text.trim()); if (clips.length > 5) clips.pop(); setStorageData('mf_clips_v6', clips); }
          addLog("Clipboard ditempel & disimpan ke Clip Stack.", "log-succ");
        }
      } catch (err) { addLog("ERR: Izinkan akses clipboard.", "log-err"); }
    });

    // Keyboard Hotkeys
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && appWrapper.classList.contains('active')) { btnDownload.click(); }
      if (e.ctrlKey && e.key === 'v') { setTimeout(() => { document.getElementById('btn-paste').click(); }, 100); }
    });

    // Export TXT / JSON
    document.getElementById('btn-export-txt').addEventListener('click', () => {
      playBeep(900);
      const h = getStorageData('mf_history_v6');
      if (h.length === 0) { addLog("ERR: Cache kosong.", "log-err"); return; }
      let content = "=== RAMZYY03 BYPASS REPORT ===\n\n";
      h.forEach((item, i) => { content += `[${i+1}] ${item.time} | ${item.type}\nURL: ${item.url}\n--------------------\n`; });
      const blob = new Blob([content], { type: 'text/plain' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a'); a.href = url; a.download = `Report_${Date.now()}.txt`; a.click();
      addLog("Export ke .txt berhasil.", "log-succ");
    });

    document.getElementById('btn-export-json').addEventListener('click', () => {
      playBeep(900);
      const h = getStorageData('mf_history_v6');
      const blob = new Blob([JSON.stringify(h, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a'); a.href = url; a.download = `Report_${Date.now()}.json`; a.click();
      addLog("Export ke .json berhasil.", "log-succ");
    });

    document.getElementById('clear-cache').addEventListener('click', () => {
      playBeep(300); localStorage.removeItem('mf_history_v6'); renderDynamicList(); addLog("Cache dibersihkan.", "log-warn");
    });

    // EXECUTE BYPASS
    btnDownload.addEventListener('click', async () => {
      playBeep(700); btnCopy.disabled = true; currentDirectLink = ""; qrBox.classList.remove('active'); benchmarkInfo.style.display = 'none';
      const startTime = performance.now();
      const uaMode = document.getElementById('user-agent-select').value;
      const engineMode = document.getElementById('engine-mode').value;
      const autoDownload = document.getElementById('toggle-autodownload').checked;
      const autoClear = document.getElementById('toggle-autoclear').checked;

      const url = linkInput.value.trim();
      if (!url || !url.startsWith('http')) {
        playBeep(200, 'sawtooth', 0.2); addLog("ERR: URL target tidak valid.", "log-err"); return;
      }

      btnDownload.disabled = true; btnDownload.innerHTML = 'MEMPROSES...';
      addLog(`Menganalisa target [UA: ${uaMode} | Engine: ${engineMode}]...`, "log-warn");
      await sleep(500);

      try {
        const response = await fetch('/api/extract', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url, ua: uaMode, engine: engineMode })
        });
        const data = await response.json();
        const duration = ((performance.now() - startTime) / 1000).toFixed(2);

        if (data.success) {
          currentDirectLink = data.direct_link; btnCopy.disabled = false;
          playBeep(1200, 'sine', 0.2);
          
          addLog(`Protokol: [${data.type}]`, "log-info");
          addLog("Payload decrypter berhasil di-generate!", "log-succ");
          
          benchmarkInfo.innerText = `⚡ Extracted successfully in ${duration}s`;
          benchmarkInfo.style.display = 'block';

          qrImg.src = `https://api.qrserver.com/v1/create-qr-code/?size=100x100&data=${encodeURIComponent(data.direct_link)}`;
          qrBox.classList.add('active');

          const h = getStorageData('mf_history_v6');
          h.unshift({ url, time: new Date().toLocaleTimeString('id-ID', { hour12: false }), type: data.type });
          if (h.length > 10) h.pop();
          setStorageData('mf_history_v6', h); renderDynamicList();

          navigator.clipboard.writeText(data.direct_link).catch(() => {});

          if (autoDownload) {
            setTimeout(() => {
              const iframe = document.createElement('iframe'); iframe.style.display = 'none'; iframe.src = data.direct_link;
              document.body.appendChild(iframe);
              addLog("Unduhan siluman via iFrame aktif & Auto-Copy Clipboard!", "log-succ");
            }, 800);
          }

          if (autoClear) { linkInput.value = ''; }

        } else {
          playBeep(200, 'sawtooth', 0.2); addLog(`ERR: ${data.message}`, "log-err");
        }
      } catch (err) {
        playBeep(200, 'sawtooth', 0.2); addLog("ERR: Gagal terhubung ke backend server.", "log-err");
      } finally {
        btnDownload.disabled = false;
        btnDownload.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg> EKSTRAK & UNDUH`;
      }
    });

    btnCopy.addEventListener('click', () => {
      if (currentDirectLink) {
        navigator.clipboard.writeText(currentDirectLink).then(() => {
          playBeep(950, 'sine', 0.1); addLog("Direct link disalin ke clipboard!", "log-succ");
          btnCopy.innerHTML = "COPIED!"; setTimeout(() => { btnCopy.innerHTML = `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg> COPY`; }, 2000);
        });
      }
    });
  </script>
</body>
</html>
