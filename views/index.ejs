<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>MF BYPASS - by Ramzyy03</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&family=Rajdhani:wght@500;600;700&display=swap');

    :root {
      --bg-main: #05050a;
      --card-bg: rgba(15, 15, 25, 0.75);
      --neon-blue: #00f3ff;
      --neon-orange: #ff7700;
      --text-main: #ffffff;
      --text-muted: #8b949e;
      --border-color: rgba(0, 243, 255, 0.15);
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background-color: var(--bg-main);
      background-image: 
        radial-gradient(circle at 15% 50%, rgba(0, 243, 255, 0.08) 0%, transparent 50%),
        radial-gradient(circle at 85% 30%, rgba(255, 119, 0, 0.08) 0%, transparent 50%);
      color: var(--text-main);
      font-family: 'Rajdhani', sans-serif;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      padding: 20px;
      overflow: hidden;
    }

    /* Animasi Grid Latar Belakang */
    .bg-grid {
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%;
      background-image: 
        linear-gradient(rgba(0, 243, 255, 0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0, 243, 255, 0.03) 1px, transparent 1px);
      background-size: 40px 40px;
      z-index: -1;
      pointer-events: none;
    }

    .container {
      background: var(--card-bg);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid var(--border-color);
      border-radius: 24px;
      padding: 40px 30px;
      width: 100%;
      max-width: 480px;
      box-shadow: 0 20px 50px rgba(0, 0, 0, 0.8), inset 0 0 20px rgba(0, 243, 255, 0.03);
      position: relative;
      z-index: 1;
    }

    /* Garis Dekoratif Atas */
    .container::before {
      content: '';
      position: absolute;
      top: 0; left: 15%; width: 70%; height: 2px;
      background: linear-gradient(90deg, transparent, var(--neon-blue), transparent);
      border-radius: 50%;
    }

    .header { text-align: center; margin-bottom: 35px; }
    .header h1 { 
      font-family: 'Orbitron', sans-serif;
      font-size: 1.8rem; 
      font-weight: 900;
      color: #fff;
      letter-spacing: 2px;
      text-shadow: 0 0 15px rgba(0, 243, 255, 0.6);
      margin-bottom: 8px;
    }
    .header p { 
      font-size: 1.05rem; 
      color: var(--text-muted); 
      letter-spacing: 0.5px;
    }

    .input-group { position: relative; margin-bottom: 24px; }
    .input-group svg {
      position: absolute;
      left: 18px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--neon-blue);
      width: 20px; height: 20px;
      filter: drop-shadow(0 0 5px rgba(0, 243, 255, 0.5));
    }
    
    input[type="url"] {
      width: 100%;
      padding: 18px 18px 18px 50px;
      background: rgba(0, 0, 0, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 16px;
      color: #fff;
      font-size: 1rem;
      font-family: monospace;
      outline: none;
      transition: all 0.3s ease;
    }
    input[type="url"]:focus { 
      border-color: var(--neon-blue); 
      box-shadow: 0 0 20px rgba(0, 243, 255, 0.15); 
    }
    input[type="url"]::placeholder { color: #4b5563; }

    .btn-download {
      width: 100%;
      padding: 18px;
      background: linear-gradient(135deg, var(--neon-orange), #d9381e);
      color: white;
      border: none;
      border-radius: 16px;
      font-family: 'Orbitron', sans-serif;
      font-weight: 700;
      font-size: 1.05rem;
      letter-spacing: 1.5px;
      cursor: pointer;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 12px;
      transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: 0 0 20px rgba(255, 119, 0, 0.3);
      position: relative;
      overflow: hidden;
    }
    
    .btn-download::after {
      content: '';
      position: absolute;
      top: 0; left: -100%; width: 50%; height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.2), transparent);
      transform: skewX(-25deg);
      transition: all 0.5s;
    }
    
    .btn-download:hover { 
      transform: translateY(-3px); 
      box-shadow: 0 8px 25px rgba(255, 119, 0, 0.5); 
    }
    .btn-download:hover::after { left: 150%; }
    .btn-download:active { transform: scale(0.97); }
    
    .btn-download:disabled { 
      background: #1c1c24; 
      color: #52525b; 
      cursor: not-allowed; 
      box-shadow: none; 
      transform: none; 
      border: 1px solid #272730;
    }
    .btn-download:disabled::after { display: none; }

    .status-box {
      margin-top: 24px;
      padding: 16px;
      border-radius: 12px;
      font-size: 1rem;
      font-weight: 600;
      display: none;
      word-break: break-all;
      text-align: center;
      animation: slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    
    .status-box.active { display: block; }
    .status-loading { background: rgba(0, 243, 255, 0.05); border: 1px solid rgba(0, 243, 255, 0.3); color: var(--neon-blue); text-shadow: 0 0 10px rgba(0, 243, 255, 0.5); }
    .status-success { background: rgba(0, 255, 136, 0.05); border: 1px solid rgba(0, 255, 136, 0.3); color: #00ff88; text-shadow: 0 0 10px rgba(0, 255, 136, 0.5); }
    .status-error { background: rgba(255, 0, 60, 0.05); border: 1px solid rgba(255, 0, 60, 0.3); color: #ff003c; text-shadow: 0 0 10px rgba(255, 0, 60, 0.5); }

    @keyframes slideUp { from { opacity: 0; transform: translateY(15px); } to { opacity: 1; transform: translateY(0); } }

    /* Footer Credits */
    .footer {
      margin-top: 40px;
      text-align: center;
      display: flex;
      flex-direction: column;
      gap: 6px;
      z-index: 2;
    }
    .footer .author {
      font-family: 'Orbitron', sans-serif;
      font-size: 0.95rem;
      color: var(--neon-blue);
      font-weight: 700;
      letter-spacing: 2px;
      text-shadow: 0 0 10px rgba(0, 243, 255, 0.6);
    }
    .footer .sub-credit {
      font-size: 0.8rem;
      color: rgba(255, 255, 255, 0.4);
      letter-spacing: 0.5px;
    }
  </style>
</head>
<body>

  <div class="bg-grid"></div>

  <div class="container">
    <div class="header">
      <h1>MF BYPASS</h1>
      <p>Direct Link Extractor Engine</p>
    </div>

    <div class="input-group">
      <!-- SVG Link Icon -->
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
      </svg>
      <input type="url" id="link-input" placeholder="https://www.mediafire.com/file/..." autocomplete="off" required>
    </div>

    <button class="btn-download" id="btn-download">
      <!-- SVG Download Icon -->
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
        <polyline points="7 10 12 15 17 10"></polyline>
        <line x1="12" y1="15" x2="12" y2="3"></line>
      </svg>
      EKSTRAK & UNDUH
    </button>

    <div id="status-box" class="status-box"></div>
  </div>

  <div class="footer">
    <div class="author">AUTHOR RAMZYY03</div>
    <div class="sub-credit">System Engine V1.0 • Node.js Backend</div>
  </div>

  <script>
    const btnDownload = document.getElementById('btn-download');
    const linkInput = document.getElementById('link-input');
    const statusBox = document.getElementById('status-box');

    function showStatus(message, type) {
      statusBox.className = `status-box active status-${type}`;
      
      // Menambahkan animasi titik-titik jika loading
      if (type === 'loading') {
        let dots = 0;
        statusBox.innerText = message;
        window.loadingInterval = setInterval(() => {
          dots = (dots + 1) % 4;
          statusBox.innerText = message + '.'.repeat(dots);
        }, 400);
      } else {
        clearInterval(window.loadingInterval);
        statusBox.innerText = message;
      }
    }

    btnDownload.addEventListener('click', async () => {
      const url = linkInput.value.trim();

      if (!url) {
        showStatus('SYSTEM: Harap masukkan link MediaFire.', 'error');
        return;
      }

      // State Loading
      btnDownload.disabled = true;
      btnDownload.innerHTML = `
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="spin">
          <line x1="12" y1="2" x2="12" y2="6"></line>
          <line x1="12" y1="18" x2="12" y2="22"></line>
          <line x1="4.93" y1="4.93" x2="7.76" y2="7.76"></line>
          <line x1="16.24" y1="16.24" x2="19.07" y2="19.07"></line>
          <line x1="2" y1="12" x2="6" y2="12"></line>
          <line x1="18" y1="12" x2="22" y2="12"></line>
          <line x1="4.93" y1="19.07" x2="7.76" y2="16.24"></line>
          <line x1="16.24" y1="7.76" x2="19.07" y2="4.93"></line>
        </svg>
        MEMPROSES...
      `;
      // Tambah style spin sementara untuk icon loading
      const style = document.createElement('style');
      style.innerHTML = '.spin { animation: spin 1s linear infinite; } @keyframes spin { 100% { transform: rotate(360deg); } }';
      document.head.appendChild(style);

      showStatus('Bypassing server security', 'loading');

      try {
        const response = await fetch('/api/extract', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url: url })
        });

        const data = await response.json();

        if (data.success) {
          clearInterval(window.loadingInterval);
          showStatus('Bypass Berhasil! Unduhan dimulai.', 'success');
          
          // Trigger download
          setTimeout(() => {
            const a = document.createElement('a');
            a.href = data.direct_link;
            a.style.display = 'none';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
          }, 800);

        } else {
          clearInterval(window.loadingInterval);
          showStatus(`SYSTEM ERROR: ${data.message}`, 'error');
        }
      } catch (err) {
        clearInterval(window.loadingInterval);
        showStatus('NETWORK ERROR: Koneksi server gagal.', 'error');
      } finally {
        // Reset Button
        setTimeout(() => {
          btnDownload.disabled = false;
          btnDownload.innerHTML = `
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
            EKSTRAK & UNDUH
          `;
        }, 2000);
      }
    });
  </script>
</body>
</html>
