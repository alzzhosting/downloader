<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>CYBER BYPASS ENGINE V6.0 - by Ramzyy03</title>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;600&family=Orbitron:wght@500;700;900&family=Rajdhani:wght@500;600;700&display=swap');

    :root {
      --bg-main: #010104;
      --card-bg: rgba(10, 10, 18, 0.88);
      --neon-cyan: #00f3ff;
      --neon-purple: #b026ff;
      --neon-green: #00ff88;
      --neon-red: #ff2a2a;
      --text-main: #f8fafc;
      --text-muted: #64748b;
      --border-glow: rgba(176, 38, 255, 0.3);
      --font-ui: 'Rajdhani', sans-serif;
      --font-mono: 'Fira Code', monospace;
      --font-display: 'Orbitron', sans-serif;
    }

    body.theme-cyan { --neon-purple: #00f3ff; --border-glow: rgba(0, 243, 255, 0.3); }
    body.theme-green { --neon-purple: #00ff88; --border-glow: rgba(0, 255, 136, 0.3); }
    body.theme-orange { --neon-purple: #ff7700; --border-glow: rgba(255, 119, 0, 0.3); }
    body.theme-purple { --neon-purple: #b026ff; --border-glow: rgba(176, 38, 255, 0.3); }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background-color: var(--bg-main);
      color: var(--text-main);
      font-family: var(--font-ui);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      overflow-x: hidden;
    }

    /* Matrix Rain Canvas */
    #matrix-canvas {
      position: fixed; top: 0; left: 0; width: 100%; height: 100%;
      z-index: 1; pointer-events: none; opacity: 0.18;
    }

    /* Cyber Scanline */
    body::after {
      content: " "; display: block; position: fixed; top: 0; left: 0; bottom: 0; right: 0;
      background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.02), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.02));
      z-index: 2; background-size: 100% 3px, 3px 100%; pointer-events: none;
    }

    /* CAPTCHA OVERLAY */
    .cf-overlay {
      position: fixed; top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(1, 1, 4, 0.96); backdrop-filter: blur(16px);
      z-index: 9999; display: flex; flex-direction: column; justify-content: center; align-items: center;
      transition: opacity 0.5s ease;
    }
    .cf-overlay.hidden { opacity: 0; pointer-events: none; }
    
    .cf-box {
      background: linear-gradient(135deg, rgba(15, 15, 25, 0.95), rgba(8, 8, 14, 0.98));
      border: 1px solid var(--neon-purple); border-radius: 16px; padding: 25px; width: 100%; max-width: 360px;
      box-shadow: 0 0 40px var(--border-glow); display: flex; flex-direction: column; gap: 16px; text-align: center;
      z-index: 3; position: relative;
    }
    .cf-title { font-family: var(--font-display); font-size: 0.9rem; color: var(--neon-cyan); letter-spacing: 1px; }
    
    .captcha-display {
      background: #000; border: 1px dashed var(--neon-purple); border-radius: 8px;
      padding: 12px; font-family: var(--font-mono); font-size: 1.5rem; font-weight: bold;
      color: var(--neon-cyan); letter-spacing: 6px; user-select: none;
      display: flex; justify-content: center; align-items: center; gap: 10px;
    }
    .refresh-captcha { background: transparent; border: none; color: var(--text-muted); cursor: pointer; font-size: 1rem; }
    .refresh-captcha:hover { color: #fff; }

    .captcha-input {
      width: 100%; padding: 12px; background: rgba(0,0,0,0.6); border: 1px solid rgba(255,255,255,0.1);
      border-radius: 8px; color: #fff; font-family: var(--font-mono); font-size: 1rem; text-align: center; outline: none; letter-spacing: 2px;
    }
    .captcha-input:focus { border-color: var(--neon-purple); box-shadow: 0 0 10px var(--border-glow); }

    .captcha-btn {
      width: 100%; padding: 12px; background: linear-gradient(135deg, var(--neon-purple), #6366f1);
      border: none; border-radius: 8px; color: #fff; font-family: var(--font-display); font-weight: 700; cursor: pointer; transition: 0.2s;
    }
    .captcha-btn:hover { transform: translateY(-2px); box-shadow: 0 0 15px var(--border-glow); }
    .cf-footer-secure { font-size: 0.68rem; color: var(--text-muted); font-family: var(--font-mono); border-top: 1px solid rgba(255,255,255,0.05); padding-top: 10px; }

    /* MAIN APP WRAPPER */
    .app-wrapper {
      width: 100%; max-width: 540px; padding: 20px; z-index: 10;
      display: none; flex-direction: column; gap: 14px;
      animation: zoom-in 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .app-wrapper.active { display: flex; }
    @keyframes zoom-in { 0% { opacity: 0; transform: scale(0.92); filter: blur(8px); } 100% { opacity: 1; transform: scale(1); filter: blur(0); } }

    /* HUD Header */
    .hud-header {
      background: var(--card-bg); backdrop-filter: blur(16px);
      border: 1px solid var(--border-glow); border-radius: 14px; padding: 14px 18px;
      display: flex; justify-content: space-between; align-items: center; box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }
    .hud-title h1 { font-family: var(--font-display); font-size: 1.25rem; color: #fff; letter-spacing: 1px; text-shadow: 0 0 10px var(--border-glow); }
    .hud-title p { font-size: 0.7rem; color: var(--neon-cyan); font-family: var(--font-mono); }
    
    .hud-stats { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; }
    .status-badge { display: flex; align-items: center; gap: 6px; font-size: 0.65rem; font-family: var(--font-mono); color: var(--neon-green); background: rgba(0, 255, 136, 0.1); padding: 2px 8px; border-radius: 20px; border: 1px solid rgba(0, 255, 136, 0.3); }
    .status-dot { width: 5px; height: 5px; background: var(--neon-green); border-radius: 50%; box-shadow: 0 0 6px var(--neon-green); animation: pulse 1.5s infinite; }
    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.4; } }

    /* Quick Ticker Marquee */
    .ticker-bar {
      background: rgba(0, 243, 255, 0.05); border: 1px solid rgba(0, 243, 255, 0.15); border-radius: 8px;
      padding: 6px 12px; font-size: 0.7rem; font-family: var(--font-mono); color: var(--neon-cyan);
      overflow: hidden; white-space: nowrap; box-shadow: inset 0 0 10px rgba(0, 243, 255, 0.03);
    }
    .ticker-bar span { display: inline-block; padding-left: 100%; animation: ticker 22s linear infinite; }
    @keyframes ticker { 0% { transform: translate(0, 0); } 100% { transform: translate(-100%, 0); } }

    /* Panels */
    .panel {
      background: var(--card-bg); backdrop-filter: blur(16px);
      border: 1px solid var(--border-glow); border-radius: 14px; padding: 16px;
      box-shadow: 0 10px 30px rgba(0,0,0,0.5); position: relative;
    }
    .panel-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
    .panel-title { font-family: var(--font-display); font-size: 0.8rem; color: var(--neon-cyan); display: flex; align-items: center; gap: 8px; }
    .panel-title::before { content: ''; width: 6px; height: 6px; background: var(--neon-cyan); border-radius: 50%; box-shadow: 0 0 6px var(--neon-cyan); }

    /* Controls Bar */
    .controls-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 10px; }
    .control-select, .control-input {
      background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.1); color: var(--text-main);
      font-family: var(--font-mono); font-size: 0.72rem; padding: 7px 10px; border-radius: 8px; outline: none; width: 100%;
    }
    .control-select:focus, .control-input:focus { border-color: var(--neon-purple); }

    /* Options & Toggles Bar */
    .toggles-bar { display: flex; gap: 10px; font-size: 0.7rem; font-family: var(--font-mono); color: var(--text-muted); margin-bottom: 10px; align-items: center; flex-wrap: wrap; }
    .toggles-bar label { display: flex; align-items: center; gap: 4px; cursor: pointer; }
    .toggles-bar input[type="checkbox"] { accent-color: var(--neon-purple); cursor: pointer; }

    /* Input & Buttons */
    .input-wrapper { position: relative; margin-bottom: 10px; }
    .input-box {
      width: 100%; padding: 13px 45px 13px 13px; background: rgba(0,0,0,0.6); border: 1px solid rgba(255,255,255,0.1);
      border-radius: 10px; color: #fff; font-family: var(--font-mono); font-size: 0.8rem; outline: none; transition: all 0.3s; resize: none;
    }
    .input-box:focus { border-color: var(--neon-purple); box-shadow: 0 0 15px var(--border-glow); }

    .paste-btn {
      position: absolute; right: 8px; top: 50%; transform: translateY(-50%);
      background: rgba(176, 38, 255, 0.15); border: 1px solid var(--border-glow); color: var(--neon-purple);
      padding: 5px 8px; border-radius: 6px; font-size: 0.65rem; font-family: var(--font-mono); cursor: pointer; transition: 0.2s;
    }
    .paste-btn:hover { background: var(--neon-purple); color: #fff; }

    .btn-group { display: flex; gap: 8px; }
    .btn {
      flex: 1; padding: 12px; border: none; border-radius: 10px; font-family: var(--font-display);
      font-weight: 700; font-size: 0.8rem; letter-spacing: 1px; cursor: pointer; display: flex;
      justify-content: center; align-items: center; gap: 8px; transition: all 0.25s;
    }
    .btn-main { background: linear-gradient(135deg, var(--neon-purple), #6366f1); color: #fff; box-shadow: 0 0 20px var(--border-glow); }
    .btn-main:hover { transform: translateY(-2px); box-shadow: 0 0 25px var(--border-glow); }
    .btn-main:active { transform: scale(0.97); }
    .btn-main:disabled { background: #222; color: #555; box-shadow: none; cursor: not-allowed; transform: none; }

    .btn-sec { background: transparent; border: 1px solid var(--neon-cyan); color: var(--neon-cyan); }
    .btn-sec:hover { background: rgba(0, 243, 255, 0.1); }
    .btn-sec:disabled { border-color: #222; color: #555; cursor: not-allowed; }

    /* Benchmark & QR Box */
    .benchmark-info { font-size: 0.68rem; font-family: var(--font-mono); color: var(--neon-green); margin-top: 6px; display: none; }
    .qr-preview-box {
      margin-top: 10px; background: rgba(0,0,0,0.4); border: 1px dashed rgba(0, 243, 255, 0.3);
      border-radius: 8px; padding: 8px; display: none; align-items: center; gap: 10px;
    }
    .qr-preview-box.active { display: flex; }
    .qr-image { width: 50px; height: 50px; background: #fff; padding: 2px; border-radius: 4px; }
    .qr-info { font-size: 0.7rem; font-family: var(--font-mono); color: var(--text-muted); word-break: break-all; }
    .qr-info span { color: var(--neon-cyan); display: block; font-weight: bold; }

    /* Terminal Console */
    .terminal { background: #010103; border-color: rgba(0, 243, 255, 0.15); transition: 0.3s; }
    .terminal.fullscreen { position: fixed; top: 10px; left: 10px; right: 10px; bottom: 10px; z-index: 99999; height: auto !important; }
    .term-window { height: 100px; overflow-y: auto; font-family: var(--font-mono); font-size: 0.7rem; line-height: 1.4; color: var(--text-muted); display: flex; flex-direction: column; gap: 3px; }
    .terminal.fullscreen .term-window { height: calc(100vh - 80px); }
    .log-sys { color: #888; } .log-warn { color: #f59e0b; } .log-succ { color: var(--neon-green); text-shadow: 0 0 6px rgba(0,255,136,0.4); } .log-err { color: var(--neon-red); text-shadow: 0 0 6px rgba(255,42,42,0.4); } .log-info { color: var(--neon-cyan); }
    .blinking-cursor { display: inline-block; width: 5px; height: 11px; background: var(--neon-cyan); animation: blink 1s step-end infinite; margin-left: 4px; }
    @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

    /* History & Favorites & Clipboard Stack */
    .sub-tabs { display: flex; gap: 6px; margin-bottom: 8px; }
    .sub-tab-btn { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05); color: var(--text-muted); font-size: 0.68rem; font-family: var(--font-mono); padding: 4px 8px; border-radius: 6px; cursor: pointer; }
    .sub-tab-btn.active { background: var(--neon-cyan); color: #000; font-weight: bold; }

    .history-actions { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
    .action-link-btn { font-size: 0.65rem; background: transparent; border: none; color: var(--neon-cyan); cursor: pointer; font-family: var(--font-mono); }
    .action-link-btn:hover { text-decoration: underline; }
    
    .list-container { display: flex; flex-direction: column; gap: 5px; max-height: 100px; overflow-y: auto; }
    .list-item { background: rgba(255,255,255,0.02); padding: 7px 10px; border-radius: 6px; border-left: 3px solid var(--neon-purple); display: flex; justify-content: space-between; align-items: center; }
    .list-item-info { display: flex; flex-direction: column; gap: 2px; overflow: hidden; max-width: 300px; }
    .list-item span.url { font-family: var(--font-mono); font-size: 0.65rem; color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .list-item span.meta { font-size: 0.6rem; color: var(--neon-green); font-weight: 600; font-family: var(--font-mono); }
    .empty-msg { font-size: 0.75rem; color: var(--text-muted); text-align: center; font-style: italic; padding: 8px 0; }

    /* Footer */
    .footer { text-align: center; margin-top: 2px; }
    .footer .author { font-family: var(--font-display); font-size: 0.9rem; color: var(--neon-cyan); font-weight: 900; letter-spacing: 2px; text-shadow: 0 0 10px rgba(0, 243, 255, 0.4); }
    .footer .sub { font-size: 0.65rem; color: var(--text-muted); font-family: var(--font-mono); margin-top: 2px; }
    
    ::-webkit-scrollbar { width: 4px; } ::-webkit-scrollbar-track { background: transparent; } ::-webkit-scrollbar-thumb { background: var(--border-glow); border-radius: 10px; }
  </style>
</head>
