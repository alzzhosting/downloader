<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>FIVEM HUD BYPASS & AI</title>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@500;700;900&family=Share+Tech+Mono&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg-color: #0c0d12;
      --card-bg: #141620;
      --border-color: #232738;
      --accent-cyan: #00e5ff;
      --accent-purple: #9c27b0;
      --accent-green: #00e676;
      --accent-red: #ff5252;
      --text-main: #ffffff;
      --text-muted: #8c92a4;
      --font-hud: 'Montserrat', sans-serif;
      --font-mono: 'Share Tech Mono', monospace;
    }

    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      background-color: var(--bg-color);
      color: var(--text-main);
      font-family: var(--font-hud);
      min-height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 15px;
      overflow-x: hidden;
    }

    /* --- CAPTCHA OVERLAY --- */
    .cf-overlay {
      position: fixed; top: 0; left: 0; right: 0; bottom: 0;
      background: rgba(12, 13, 18, 0.95);
      z-index: 9999; display: flex; flex-direction: column; justify-content: center; align-items: center;
      transition: opacity 0.3s ease;
    }
    .cf-overlay.hidden { opacity: 0; pointer-events: none; }
    
    .cf-box {
      background: var(--card-bg); border: 2px solid var(--accent-cyan);
      border-radius: 6px; padding: 24px; width: 100%; max-width: 340px;
      box-shadow: 0 0 20px rgba(0, 229, 255, 0.2);
      display: flex; flex-direction: column; gap: 14px; text-align: center;
    }
    .cf-title { font-size: 0.95rem; font-weight: 900; color: var(--accent-cyan); letter-spacing: 1px; text-transform: uppercase; }
    
    .captcha-display {
      background: #08090d; border: 1px solid var(--border-color); border-radius: 4px;
      padding: 10px; font-family: var(--font-mono); font-size: 1.4rem; font-weight: bold;
      color: var(--accent-cyan); letter-spacing: 5px;
      display: flex; justify-content: center; align-items: center; gap: 10px;
    }
    .refresh-captcha { background: transparent; border: none; color: var(--text-muted); cursor: pointer; font-size: 0.9rem; }
    .refresh-captcha:hover { color: #fff; }

    .captcha-input {
      width: 100%; padding: 12px; background: #08090d; border: 1px solid var(--border-color);
      border-radius: 4px; color: #fff; font-family: var(--font-mono); font-size: 1rem; text-align: center; outline: none;
      letter-spacing: 2px; text-transform: uppercase;
    }
    .captcha-input:focus { border-color: var(--accent-cyan); }

    .captcha-btn {
      width: 100%; padding: 12px; background: var(--accent-cyan);
      border: none; border-radius: 4px; color: #000; font-family: var(--font-hud); font-weight: 900;
      font-size: 0.85rem; text-transform: uppercase; cursor: pointer; transition: 0.2s;
    }
    .captcha-btn:hover { background: #00b8d4; }
    .cf-footer-secure { font-size: 0.65rem; color: var(--text-muted); font-family: var(--font-mono); border-top: 1px solid var(--border-color); padding-top: 8px; text-transform: uppercase; }

    /* --- MAIN APP WRAPPER --- */
    .app-wrapper {
      width: 100%; max-width: 480px; display: none; flex-direction: column; gap: 12px;
      animation: fadeIn 0.3s ease forwards;
    }
    .app-wrapper.active { display: flex; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }

    /* HUD Header */
    .hud-header {
      background: var(--card-bg); border: 1px solid var(--border-color); border-left: 4px solid var(--accent-cyan);
      border-radius: 4px; padding: 12px 16px; display: flex; justify-content: space-between; align-items: center;
    }
    .hud-title h1 { font-size: 1.1rem; font-weight: 900; letter-spacing: 1px; text-transform: uppercase; }
    .hud-title p { font-size: 0.65rem; color: var(--accent-cyan); font-family: var(--font-mono); text-transform: uppercase; }
    
    .status-badge { display: flex; align-items: center; gap: 5px; font-size: 0.65rem; font-family: var(--font-mono); color: var(--accent-green); background: rgba(0, 230, 118, 0.1); padding: 3px 8px; border-radius: 3px; border: 1px solid rgba(0, 230, 118, 0.3); text-transform: uppercase; }
    .status-dot { width: 5px; height: 5px; background: var(--accent-green); border-radius: 50%; box-shadow: 0 0 5px var(--accent-green); }

    /* Main Navigation Switcher (Extractor vs Gita AI) */
    .nav-switcher { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
    .nav-tab-btn {
      background: var(--card-bg); border: 1px solid var(--border-color); color: var(--text-muted);
      font-family: var(--font-hud); font-weight: 900; font-size: 0.72rem; padding: 10px; border-radius: 4px;
      cursor: pointer; text-transform: uppercase; text-align: center; transition: 0.2s;
    }
    .nav-tab-btn.active { background: var(--accent-cyan); color: #000; border-color: var(--accent-cyan); box-shadow: 0 0 10px rgba(0, 229, 255, 0.2); }

    /* Panels */
    .panel {
      background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 4px; padding: 14px; position: relative;
    }
    .panel-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; }
    .panel-title { font-size: 0.75rem; font-weight: 900; color: var(--accent-cyan); text-transform: uppercase; letter-spacing: 0.5px; }

    /* Controls Bar */
    .controls-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 10px; }
    .control-select, .control-input {
      background: #08090d; border: 1px solid var(--border-color); color: var(--text-main);
      font-family: var(--font-mono); font-size: 0.7rem; padding: 8px; border-radius: 4px; outline: none; width: 100%; text-transform: uppercase;
    }
    .control-select:focus { border-color: var(--accent-cyan); }

    /* Toggles Bar */
    .toggles-bar { display: flex; gap: 12px; font-size: 0.68rem; font-family: var(--font-mono); color: var(--text-muted); margin-bottom: 10px; align-items: center; flex-wrap: wrap; text-transform: uppercase; }
    .toggles-bar label { display: flex; align-items: center; gap: 5px; cursor: pointer; }
    .toggles-bar input[type="checkbox"] { accent-color: var(--accent-cyan); cursor: pointer; }

    /* Input & Buttons */
    .input-wrapper { position: relative; margin-bottom: 10px; }
    .input-box {
      width: 100%; padding: 12px 45px 12px 10px; background: #08090d; border: 1px solid var(--border-color);
      border-radius: 4px; color: #fff; font-family: var(--font-mono); font-size: 0.78rem; outline: none; transition: 0.2s; resize: none;
    }
    .input-box:focus { border-color: var(--accent-cyan); }

    .paste-btn {
      position: absolute; right: 6px; top: 50%; transform: translateY(-50%);
      background: rgba(0, 229, 255, 0.1); border: 1px solid rgba(0, 229, 255, 0.3); color: var(--accent-cyan);
      padding: 5px 8px; border-radius: 3px; font-size: 0.65rem; font-family: var(--font-mono); cursor: pointer; text-transform: uppercase;
    }
    .paste-btn:hover { background: var(--accent-cyan); color: #000; }

    .btn-group { display: flex; gap: 8px; }
    .btn {
      flex: 1; padding: 11px; border: none; border-radius: 4px; font-family: var(--font-hud);
      font-weight: 900; font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1px; cursor: pointer; display: flex;
      justify-content: center; align-items: center; gap: 6px; transition: 0.2s;
    }
    .btn-main { background: var(--accent-cyan); color: #000; box-shadow: 0 0 10px rgba(0, 229, 255, 0.2); }
    .btn-main:hover { background: #00b8d4; }
    .btn-main:disabled { background: #1a1c26; color: #4a4f66; cursor: not-allowed; box-shadow: none; }

    .btn-sec { background: transparent; border: 1px solid var(--border-color); color: var(--text-muted); }
    .btn-sec:hover { border-color: var(--accent-cyan); color: var(--accent-cyan); }
    .btn-sec:disabled { opacity: 0.4; cursor: not-allowed; }

    /* QR Code Matrix */
    .qr-preview-box {
      margin-top: 12px; background: #08090d; border: 1px dashed var(--accent-cyan);
      border-radius: 4px; padding: 14px; display: none; align-items: center; gap: 14px;
    }
    .qr-preview-box.active { display: flex; }
    .qr-image { width: 130px; height: 130px; background: #fff; padding: 4px; border-radius: 3px; flex-shrink: 0; }
    .qr-info { font-size: 0.75rem; font-family: var(--font-mono); color: var(--text-muted); word-break: break-all; }
    .qr-info span { color: var(--accent-cyan); display: block; font-weight: bold; font-size: 0.8rem; margin-bottom: 4px; text-transform: uppercase; }

    /* Terminal Console */
    .terminal { background: #08090d; border-color: var(--border-color); }
    .term-window { height: 95px; overflow-y: auto; font-family: var(--font-mono); font-size: 0.68rem; line-height: 1.4; color: var(--text-muted); display: flex; flex-direction: column; gap: 3px; }
    .log-sys { color: #8c92a4; } .log-warn { color: #ffb300; } .log-succ { color: var(--accent-green); } .log-err { color: var(--accent-red); } .log-info { color: var(--accent-cyan); }
    .blinking-cursor { display: inline-block; width: 5px; height: 10px; background: var(--accent-cyan); animation: blink 1s step-end infinite; margin-left: 3px; }
    @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0; } }

    /* --- GITA AI CHAT STYLING --- */
    .ai-container { display: none; flex-direction: column; gap: 10px; }
    .ai-container.active { display: flex; }
    
    .chat-box {
      background: #08090d; border: 1px solid var(--border-color); border-radius: 4px;
      height: 240px; overflow-y: auto; padding: 10px; display: flex; flex-direction: column; gap: 8px;
    }
    .chat-bubble {
      max-width: 85%; padding: 8px 12px; border-radius: 4px; font-size: 0.75rem; font-family: var(--font-mono); line-height: 1.4; word-break: break-word;
    }
    .chat-bubble.user { background: rgba(0, 229, 255, 0.1); border: 1px solid rgba(0, 229, 255, 0.3); color: var(--accent-cyan); align-self: flex-end; }
    .chat-bubble.ai { background: #1a1c26; border: 1px solid var(--border-color); color: #fff; align-self: flex-start; }
    .chat-bubble.loading { color: var(--text-muted); font-style: italic; }

    .chat-input-row { display: flex; gap: 6px; }
    .chat-input {
      flex: 1; background: #08090d; border: 1px solid var(--border-color); border-radius: 4px; padding: 10px;
      color: #fff; font-family: var(--font-mono); font-size: 0.75rem; outline: none;
    }
    .chat-input:focus { border-color: var(--accent-cyan); }
    .chat-send-btn {
      background: var(--accent-cyan); border: none; border-radius: 4px; padding: 0 16px;
      font-family: var(--font-hud); font-weight: 900; font-size: 0.75rem; color: #000; cursor: pointer; text-transform: uppercase;
    }
    .chat-send-btn:hover { background: #00b8d4; }

    /* History & Lists */
    .sub-tabs { display: flex; gap: 4px; margin-bottom: 8px; }
    .sub-tab-btn { background: #08090d; border: 1px solid var(--border-color); color: var(--text-muted); font-size: 0.65rem; font-family: var(--font-mono); padding: 4px 8px; border-radius: 3px; cursor: pointer; text-transform: uppercase; }
    .sub-tab-btn.active { background: var(--accent-cyan); color: #000; font-weight: bold; border-color: var(--accent-cyan); }

    .history-actions { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
    .action-link-btn { font-size: 0.65rem; background: transparent; border: none; color: var(--accent-cyan); cursor: pointer; font-family: var(--font-mono); text-transform: uppercase; }
    .action-link-btn:hover { text-decoration: underline; }
    
    .list-container { display: flex; flex-direction: column; gap: 4px; max-height: 90px; overflow-y: auto; }
    .list-item { background: #08090d; padding: 6px 10px; border-radius: 3px; border-left: 3px solid var(--accent-cyan); display: flex; justify-content: space-between; align-items: center; }
    .list-item-info { display: flex; flex-direction: column; gap: 2px; overflow: hidden; max-width: 280px; }
    .list-item span.url { font-family: var(--font-mono); font-size: 0.62rem; color: var(--text-muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .list-item span.meta { font-size: 0.58rem; color: var(--accent-green); font-weight: 600; font-family: var(--font-mono); text-transform: uppercase; }
    .empty-msg { font-size: 0.7rem; color: var(--text-muted); text-align: center; font-style: italic; padding: 6px 0; font-family: var(--font-mono); text-transform: uppercase; }

    /* Footer */
    .footer { text-align: center; margin-top: 2px; }
    .footer .author { font-size: 0.75rem; color: var(--accent-cyan); font-weight: 900; letter-spacing: 2px; text-transform: uppercase; }
    .footer .sub { font-size: 0.6rem; color: var(--text-muted); font-family: var(--font-mono); text-transform: uppercase; }
    
    ::-webkit-scrollbar { width: 3px; }
    ::-webkit-scrollbar-thumb { background: var(--border-color); }
  </style>
</head>
<body>

  <!-- CAPTCHA OVERLAY -->
  <div id="cf-overlay" class="cf-overlay">
    <div class="cf-box">
      <div class="cf-title">FIVEM ACCESS GATE</div>
      <div style="font-size:0.7rem; color:var(--text-muted); font-family:var(--font-mono);">MASUKKAN KODE KEAMANAN:</div>
      
      <div class="captcha-display">
        <span id="captcha-code-text">F9X2</span>
        <button class="refresh-captcha" id="btn-refresh-captcha" title="Ganti">🔄</button>
      </div>

      <input type="text" class="captcha-input" id="captcha-input" placeholder="4 DIGIT KODE" autocomplete="off" maxlength="4">
      <button class="captcha-btn" id="btn-verify-captcha">AUTORISASI</button>
      
      <div class="cf-footer-secure">RAMZYY03 SECURE CORE</div>
    </div>
  </div>

  <!-- MAIN APP -->
  <div id="app-wrapper" class="app-wrapper">
    
    <!-- HUD Header -->
    <div class="hud-header">
      <div class="hud-title">
        <h1>BYPASS & AI HUD</h1>
        <p>SYSTEM v6.2 [GITA AI]</p>
      </div>
      <div class="status-badge"><div class="status-dot"></div>ONLINE</div>
    </div>

    <!-- Navigation Switcher (Extractor vs Gita AI) -->
    <div class="nav-switcher">
      <button class="nav-tab-btn active" id="tab-btn-extractor" onclick="switchMainTab('extractor')">EXTRACTOR</button>
      <button class="nav-tab-btn" id="tab-btn-ai" onclick="switchMainTab('ai')">GITA AI CHAT</button>
    </div>

    <!-- VIEW 1: EXTRACTOR PANEL -->
    <div id="view-extractor" class="panel">
      <div class="panel-header">
        <div class="panel-title">EXTRACTOR MODULE</div>
        <div style="font-size:0.65rem; font-family:var(--font-mono); color:var(--accent-green);" id="stats-counter">SAVED: 0</div>
      </div>

      <div class="controls-grid">
        <select class="control-select" id="user-agent-select">
          <option value="default">UA: STANDARD</option>
          <option value="bot">UA: GOOGLEBOT</option>
          <option value="mobile">UA: ANDROID</option>
        </select>
        <select class="control-select" id="engine-mode">
          <option value="auto">ENGINE: AUTO</option>
          <option value="deep">ENGINE: DEEP</option>
        </select>
      </div>

      <div class="toggles-bar">
        <label><input type="checkbox" id="toggle-autodownload" checked> AUTO-DL</label>
        <label><input type="checkbox" id="toggle-autoclear"> CLR INPUT</label>
        <label><input type="checkbox" id="toggle-sound" checked> SFX</label>
      </div>

      <div id="container-single">
        <div class="input-wrapper">
          <input type="url" class="input-box" id="link-input" placeholder=">> MASUKKAN URL TARGET..." autocomplete="off">
          <button class="paste-btn" id="btn-paste">PASTE</button>
        </div>
      </div>

      <div class="btn-group">
        <button class="btn btn-main" id="btn-download">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
          EKSTRAK & UNDUH
        </button>
        <button class="btn btn-sec" id="btn-copy" disabled>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
          COPY
        </button>
      </div>

      <div style="font-size:0.65rem; font-family:var(--font-mono); color:var(--accent-green); margin-top:6px; display:none;" id="benchmark-info">⚡ SELESAI DALAM 0.00s</div>
      
      <!-- QR CODE (Diperbesar) -->
      <div class="qr-preview-box" id="qr-preview-box">
        <img id="qr-img" class="qr-image" src="" alt="QR">
        <div class="qr-info">
          <span>QR CODE MATRIX</span>
          SCAN UNTUK MEMBUKA LINK PADA PERANGKAT LAIN.
        </div>
      </div>
    </div>

    <!-- VIEW 2: GITA AI CHAT PANEL -->
    <div id="view-ai" class="panel ai-container">
      <div class="panel-header">
        <div class="panel-title">GITA AI ASSISTANT</div>
        <div style="font-size:0.65rem; font-family:var(--font-mono); color:var(--accent-cyan);">SIPUTZX API</div>
      </div>
      <div class="chat-box" id="chat-messages">
        <div class="chat-bubble ai">Halo! Saya Gita AI. Ada yang bisa saya bantu hari ini?</div>
      </div>
      <div class="chat-input-row">
        <input type="text" class="chat-input" id="chat-input" placeholder="Tulis pesan ke Gita AI..." autocomplete="off">
        <button class="chat-send-btn" id="btn-send-chat">KIRIM</button>
      </div>
    </div>

    <!-- Terminal Console Panel -->
    <div class="panel terminal">
      <div class="panel-header">
        <div class="panel-title" style="color: var(--text-muted);">CONSOLE LOG</div>
        <span class="action-link-btn" id="clear-term" style="color: var(--accent-red);">[CLEAR]</span>
      </div>
      <div class="term-window" id="term-window">
        <div class="log-sys">> SYSTEM INITIALIZED. READY...</div>
      </div>
    </div>

    <!-- History & Storage Panel -->
    <div class="panel">
      <div class="history-actions">
        <div class="sub-tabs">
          <button class="sub-tab-btn active" id="subtab-history" onclick="switchSubTab('history')">LOGS</button>
          <button class="sub-tab-btn" id="subtab-fav" onclick="switchSubTab('fav')">FAV ⭐</button>
          <button class="sub-tab-btn" id="subtab-clip" onclick="switchSubTab('clip')">CLIP 📋</button>
        </div>
        <div>
          <button class="action-link-btn" id="btn-export-txt">[TXT]</button>
          <button class="action-link-btn" id="clear-cache" style="color:var(--accent-red);">[DEL]</button>
        </div>
      </div>

      <div class="list-container" id="dynamic-list-container"></div>
    </div>

    <!-- Footer -->
    <footer class="footer">
      <div class="author">RAMZYY03 DESIGN</div>
      <div class="sub">FIVEM HUD INTERFACE v6.2</div>
    </footer>

  </div>

  <script>
    // --- LIGHTWEIGHT SFX SYNTHESIZER ---
    const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    function playBeep(freq = 440, type = 'sine', duration = 0.05) {
      if (!document.getElementById('toggle-sound').checked) return;
      try {
        if (audioCtx.state === 'suspended') audioCtx.resume();
        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();
        osc.type = type; osc.frequency.value = freq;
        gain.gain.setValueAtTime(0.03, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + duration);
        osc.connect(gain); gain.connect(audioCtx.destination);
        osc.start(); osc.stop(audioCtx.currentTime + duration);
      } catch(e) {}
    }

    // --- MAIN TAB SWITCHER (Extractor vs AI Chat) ---
    function switchMainTab(tab) {
      playBeep(600);
      const extView = document.getElementById('view-extractor');
      const aiView = document.getElementById('view-ai');
      const btnExt = document.getElementById('tab-btn-extractor');
      const btnAi = document.getElementById('tab-btn-ai');

      if (tab === 'extractor') {
        extView.style.display = 'block';
        aiView.classList.remove('active');
        btnExt.classList.add('active');
        btnAi.classList.remove('active');
      } else {
        extView.style.display = 'none';
        aiView.classList.add('active');
        btnAi.classList.add('active');
        btnExt.classList.remove('active');
      }
    }

    // --- GITA AI CHAT LOGIC ---
    const chatMessages = document.getElementById('chat-messages');
    const chatInput = document.getElementById('chat-input');
    const btnSendChat = document.getElementById('btn-send-chat');

    async function sendToGitaAI() {
      const query = chatInput.value.trim();
      if (!query) return;
      playBeep(800);

      // Append User Bubble
      chatMessages.innerHTML += `<div class="chat-bubble user">${escapeHtml(query)}</div>`;
      chatInput.value = '';
      chatMessages.scrollTop = chatMessages.scrollHeight;

      // Append Loading Bubble
      const loadingId = 'loading-' + Date.now();
      chatMessages.innerHTML += `<div class="chat-bubble ai loading" id="${loadingId}">Gita AI sedang mengetik...</div>`;
      chatMessages.scrollTop = chatMessages.scrollHeight;

      try {
        const res = await fetch(`https://api.siputzx.my.id/api/ai/gita?q=${encodeURIComponent(query)}`);
        const json = await res.json();
        
        // Remove loading bubble
        document.getElementById(loadingId).remove();

        // Extract response safely
        let aiReply = "Maaf, terjadi kesalahan saat menerima respons.";
        if (json && json.data) aiReply = json.data;
        else if (json && json.result) aiReply = json.result;
        else if (json && json.message) aiReply = json.message;
        else if (typeof json === 'string') aiReply = json;

        playBeep(1000, 'sine', 0.1);
        chatMessages.innerHTML += `<div class="chat-bubble ai">${escapeHtml(aiReply)}</div>`;
        chatMessages.scrollTop = chatMessages.scrollHeight;
        addLog("Gita AI merespons pesan.", "log-succ");

      } catch (err) {
        document.getElementById(loadingId).remove();
        playBeep(200, 'sawtooth', 0.1);
        chatMessages.innerHTML += `<div class="chat-bubble ai" style="color:var(--accent-red);">Gagal terhubung ke server Gita AI.</div>`;
        chatMessages.scrollTop = chatMessages.scrollHeight;
        addLog("ERR: Gita AI gagal merespons.", "log-err");
      }
    }

    function escapeHtml(text) {
      return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
    }

    btnSendChat.addEventListener('click', sendToGitaAI);
    chatInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') sendToGitaAI();
    });

    // --- CAPTCHA LOGIC ---
    let currentCaptchaCode = "";
    const captchaCodeText = document.getElementById('captcha-code-text');
    const captchaInput = document.getElementById('captcha-input');
    const cfOverlay = document.getElementById('cf-overlay');
    const appWrapper = document.getElementById('app-wrapper');

    function generateCaptcha() {
      const chars = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
      let code = "";
      for (let i = 0; i < 4; i++) code += chars.charAt(Math.floor(Math.random() * chars.length));
      currentCaptchaCode = code; captchaCodeText.innerText = code;
    }
    generateCaptcha();

    document.getElementById('btn-refresh-captcha').addEventListener('click', () => { playBeep(400); generateCaptcha(); });
    document.getElementById('btn-verify-captcha').addEventListener('click', () => {
      if (captchaInput.value.trim().toUpperCase() === currentCaptchaCode) {
        playBeep(900, 'sine', 0.1);
        cfOverlay.classList.add('hidden');
        setTimeout(() => { cfOverlay.style.display = 'none'; appWrapper.classList.add('active'); }, 300);
      } else {
        playBeep(200, 'sawtooth', 0.15);
        captchaInput.style.borderColor = '#ff5252'; captchaInput.value = "";
        captchaInput.placeholder = "SALAH!";
        setTimeout(() => { captchaInput.style.borderColor = '#232738'; }, 800);
      }
    });

    // --- STORAGE TABS ---
    let activeSubTab = 'history';
    function switchSubTab(tab) {
      playBeep(500);
      activeSubTab = tab;
      document.querySelectorAll('.sub-tab-btn').forEach(b => b.classList.remove('active'));
      document.getElementById('subtab-' + tab).classList.add('active');
      renderDynamicList();
    }

    function getStorageData(key) { return JSON.parse(localStorage.getItem(key) || '[]'); }
    function setStorageData(key, data) { localStorage.setItem(key, JSON.stringify(data)); }

    function renderDynamicList() {
      const container = document.getElementById('dynamic-list-container');
      container.innerHTML = '';
      
      if (activeSubTab === 'history') {
        const h = getStorageData('mf_history_v6');
        document.getElementById('stats-counter').innerText = `SAVED: ${h.length}`;
        if (h.length === 0) { container.innerHTML = '<div class="empty-msg">TIDAK ADA LOG.</div>'; return; }
        h.forEach((item, idx) => {
          container.innerHTML += `
            <div class="list-item">
              <div class="list-item-info">
                <span class="meta">${item.time} - [${item.type}]</span>
                <span class="url">${item.url}</span>
              </div>
              <div style="display:flex; gap:6px;">
                <span class="action-link-btn" onclick="addToFav('${item.url}')">⭐</span>
                <span class="action-link-btn" style="color:var(--accent-red);" onclick="deleteHistory(${idx})">X</span>
              </div>
            </div>`;
        });
      } else if (activeSubTab === 'fav') {
        const favs = getStorageData('mf_favs_v6');
        if (favs.length === 0) { container.innerHTML = '<div class="empty-msg">FAVORIT KOSONG.</div>'; return; }
        favs.forEach((url, idx) => {
          container.innerHTML += `
            <div class="list-item">
              <div class="list-item-info">
                <span class="meta">FAVOURITE</span>
                <span class="url">${url}</span>
              </div>
              <span class="action-link-btn" style="color:var(--accent-red);" onclick="deleteFav(${idx})">X</span>
            </div>`;
        });
      } else if (activeSubTab === 'clip') {
        const clips = getStorageData('mf_clips_v6');
        if (clips.length === 0) { container.innerHTML = '<div class="empty-msg">CLIPBOARD KOSONG.</div>'; return; }
        clips.forEach((clip, idx) => {
          container.innerHTML += `
            <div class="list-item" onclick="document.getElementById('link-input').value='${clip}'; switchMainTab('extractor'); switchSubTab('history');">
              <div class="list-item-info">
                <span class="meta">STACK #${idx+1}</span>
                <span class="url">${clip}</span>
              </div>
            </div>`;
        });
      }
    }
    renderDynamicList();

    function addToFav(url) {
      const favs = getStorageData('mf_favs_v6');
      if (!favs.includes(url)) { favs.push(url); setStorageData('mf_favs_v6', favs); playBeep(800); addLog("DITAMBAHKAN KE FAVORIT ⭐", "log-succ"); }
    }
    function deleteHistory(idx) { const h = getStorageData('mf_history_v6'); h.splice(idx, 1); setStorageData('mf_history_v6', h); renderDynamicList(); }
    function deleteFav(idx) { const f = getStorageData('mf_favs_v6'); f.splice(idx, 1); setStorageData('mf_favs_v6', f); renderDynamicList(); }

    // --- APP CORE LOGIC ---
    const btnDownload = document.getElementById('btn-download');
    const btnCopy = document.getElementById('btn-copy');
    const linkInput = document.getElementById('link-input');
    const termWindow = document.getElementById('term-window');
    const qrBox = document.getElementById('qr-preview-box');
    const qrImg = document.getElementById('qr-img');
    const benchmarkInfo = document.getElementById('benchmark-info');
    let currentDirectLink = "";

    function addLog(msg, type = "log-sys") {
      const time = new Date().toLocaleTimeString('id-ID', { hour12: false });
      const oldCursor = document.querySelector('.blinking-cursor');
      if (oldCursor) oldCursor.remove();
      const line = document.createElement('div');
      line.className = type;
      line.innerHTML = `[${time}] ${msg} <span class="blinking-cursor"></span>`;
      termWindow.appendChild(line);
      termWindow.scrollTop = termWindow.scrollHeight;
    }

    document.getElementById('clear-term').addEventListener('click', () => { playBeep(300); termWindow.innerHTML = '<div class="log-sys">> CONSOLE CLEARED. <span class="blinking-cursor"></span></div>'; });

    const sleep = (ms) => new Promise(res => setTimeout(res, ms));

    document.getElementById('btn-paste').addEventListener('click', async () => {
      try {
        const text = await navigator.clipboard.readText();
        if (text) {
          linkInput.value = text.trim();
          playBeep(750, 'sine', 0.05);
          const clips = getStorageData('mf_clips_v6');
          if (!clips.includes(text.trim())) { clips.unshift(text.trim()); if (clips.length > 5) clips.pop(); setStorageData('mf_clips_v6', clips); }
          addLog("TEXT TEMPEL DARI CLIPBOARD.", "log-succ");
        }
      } catch (err) { addLog("ERR: IZINKAN AKSES CLIPBOARD.", "log-err"); }
    });

    document.getElementById('btn-export-txt').addEventListener('click', () => {
      playBeep(900);
      const h = getStorageData('mf_history_v6');
      if (h.length === 0) { addLog("ERR: LOG KOSONG.", "log-err"); return; }
      let content = "=== RAMZYY03 BYPASS REPORT ===\n\n";
      h.forEach((item, i) => { content += `[${i+1}] ${item.time} | ${item.type}\nURL: ${item.url}\n--------------------\n`; });
      const blob = new Blob([content], { type: 'text/plain' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a'); a.href = url; a.download = `Report_${Date.now()}.txt`; a.click();
      addLog("EXPORT TXT BERHASIL.", "log-succ");
    });

    document.getElementById('clear-cache').addEventListener('click', () => {
      playBeep(300); localStorage.removeItem('mf_history_v6'); renderDynamicList(); addLog("CACHE DIHAPUS.", "log-warn");
    });

    btnDownload.addEventListener('click', async () => {
      playBeep(700); btnCopy.disabled = true; currentDirectLink = ""; qrBox.classList.remove('active'); benchmarkInfo.style.display = 'none';
      const startTime = performance.now();
      const uaMode = document.getElementById('user-agent-select').value;
      const engineMode = document.getElementById('engine-mode').value;
      const autoDownload = document.getElementById('toggle-autodownload').checked;
      const autoClear = document.getElementById('toggle-autoclear').checked;

      const url = linkInput.value.trim();
      if (!url || !url.startsWith('http')) {
        playBeep(200, 'sawtooth', 0.1); addLog("ERR: URL TIDAK VALID.", "log-err"); return;
      }

      btnDownload.disabled = true; btnDownload.innerHTML = 'MEMPROSES...';
      addLog(`MENGEKSTRAK TARGET...`, "log-warn");
      await sleep(300);

      try {
        const response = await fetch('/api/extract', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url, ua: uaMode, engine: engineMode })
        });
        const data = await response.json();
        const duration = ((performance.now() - startTime) / 1000).toFixed(2);

        if (data.success) {
          currentDirectLink = data.direct_link; btnCopy.disabled = false;
          playBeep(1200, 'sine', 0.1);
          
          addLog(`PROTOKOL: [${data.type}]`, "log-info");
          addLog("DIRECT LINK BERHASIL DIDAPATKAN!", "log-succ");
          
          benchmarkInfo.innerText = `⚡ SELESAI DALAM ${duration}s`;
          benchmarkInfo.style.display = 'block';

          qrImg.src = `https://api.qrserver.com/v1/create-qr-code/?size=250x250&data=${encodeURIComponent(data.direct_link)}`;
          qrBox.classList.add('active');

          const h = getStorageData('mf_history_v6');
          h.unshift({ url, time: new Date().toLocaleTimeString('id-ID', { hour12: false }), type: data.type });
          if (h.length > 10) h.pop();
          setStorageData('mf_history_v6', h); renderDynamicList();

          navigator.clipboard.writeText(data.direct_link).catch(() => {});

          if (autoDownload) {
            setTimeout(() => {
              const iframe = document.createElement('iframe'); iframe.style.display = 'none'; iframe.src = data.direct_link;
              document.body.appendChild(iframe);
              addLog("UNDUHAN SILUMAN & AUTO-COPY AKTIF!", "log-succ");
            }, 500);
          }

          if (autoClear) { linkInput.value = ''; }

        } else {
          playBeep(200, 'sawtooth', 0.1); addLog(`ERR: ${data.message}`, "log-err");
        }
      } catch (err) {
        playBeep(200, 'sawtooth', 0.1); addLog("ERR: KONEKSI SERVER GAGAL.", "log-err");
      } finally {
        btnDownload.disabled = false;
        btnDownload.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg> EKSTRAK & UNDUH`;
      }
    });

    btnCopy.addEventListener('click', () => {
      if (currentDirectLink) {
        navigator.clipboard.writeText(currentDirectLink).then(() => {
          playBeep(950, 'sine', 0.08); addLog("LINK DISALIN KE CLIPBOARD.", "log-succ");
          btnCopy.innerHTML = "COPIED!"; setTimeout(() => { btnCopy.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg> COPY`; }, 2000);
        });
      }
    });
  </script>
</body>
</html>
